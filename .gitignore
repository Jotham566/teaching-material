# ---------------------------------------------------------------- environment
# Local environments are private and regenerable. Use Python 3.11+; see
# README.md for the current .iuea-grader-env setup and pinned requirements.
.iuea-env/
.iuea-grader-env/
.venv/
venv/
env/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- editors
# Office and LibreOffice write these WHILE a file is open. They vanish when
# the file is closed, and one of them once got reported as a stale deck.
~$*
.~lock.*#
*.tmp
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------- os
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- sqlite
# The teaching database IS committed: it is a deliverable and only 1.3 MB.
# Its journals are not.
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------- quarantine
# Caches and lock files moved out of the tree. See _quarantine/README.md.
_quarantine/

# ---------------------------------------------------------------- review
# The 2026-09-14 review's WRITTEN findings are committed. Its evidence
# folder is 18 MB of extracted deck text, render dumps, tool output and a
# copy of the grader, all of it regenerable from the sources in this repo,
# so only the review itself is tracked.
review/*/evidence/

# ---------------------------------------------------------------- not ignored
# Deliberately tracked, and worth saying so because they are binaries:
#   IUEA_Teaching_Plan/decks/*.pptx      45 decks, the thing you teach from
#   DataAnalysis_Track/decks/*.pptx      15 decks
#   *.docx, *.xlsx                       guides, plans, workbooks, handouts
#   figs/*.png, DataAnalysis_Track/figs  every figure on every slide
#   DataAnalysis_Track/data/riverside.db the teaching database
#   qr/*.png                             the quiz QR codes
# They are all regenerable from scripts/, but they are also the product, and
# somebody cloning this repo should be able to walk into a room and teach.

# Local repository backup, render evidence and temporary artifact builds
.git.old/
review/**
!review/2026-09-14/
!review/2026-09-14/REVIEW.md
!review/2026-09-14/CODEBASE_MAP.md
**/.build/
node_modules/
*.inspect.ndjson
.env
.env.*
!.env.example

# Lecturer-only hidden assessment checks are kept locally, not on public GitHub
IUEA_Teaching_Plan/grader/specs/hidden/

# Local document previews and downloaded build dependencies
Professional_AI_Training/**/.qa/
Professional_AI_Training/**/.local/
Professional_AI_Training/**/.deps/

# Private test marks, identity ledger and student submission snapshots
IUEA_Teaching_Plan/test_operations/grading_output/

# Local gateway credentials and development cache
.dev.vars
.dev.vars.*
.wrangler/

# Local older lecture copy; guided_practice.ipynb is the maintained version.
IUEA_Teaching_Plan/guided_practice/CML3111/W06/CML3111-Week6-guided_practice.ipynb

# Private continuous-assessment source exports and student marks.
IUEA_Teaching_Plan/assessment_operations/private/

# Private test deployment backups and rehearsal evidence
IUEA_Teaching_Plan/test_operations/private/

# Disposable authoring previews and optional synthetic voice output
**/.chart-data-*/
**/Rehearsal Audio/*.m4a
**/Rehearsal Audio/*.aiff

# Keep the small written release status linked by README; render evidence stays local.
!review/2026-09-14/REWORK_STATUS.md
Schools_ML_Track/camp_2026/figures/
Schools_ML_Track/camp_2026/build/slides/_specs/
