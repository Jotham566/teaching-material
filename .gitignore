# ---------------------------------------------------------------- environment
# The virtualenv lives inside the project and is 172 MB. Recreate it with
# python3 -m venv .iuea-env, then pip install -r requirements.txt
.iuea-env/
.venv/
venv/
env/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- editors
# Office and LibreOffice write these WHILE a file is open. They vanish when
# the file is closed, and one of them once got reported as a stale deck.
~$*
.~lock.*#
*.tmp
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------- os
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- sqlite
# The teaching database IS committed: it is a deliverable and only 1.3 MB.
# Its journals are not.
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------- quarantine
# Caches and lock files moved out of the tree. See _quarantine/README.md.
_quarantine/

# ---------------------------------------------------------------- review
# The 2026-09-14 review's WRITTEN findings are committed. Its evidence
# folder is 18 MB of extracted deck text, render dumps, tool output and a
# copy of the grader, all of it regenerable from the sources in this repo,
# so only the review itself is tracked.
review/*/evidence/

# ---------------------------------------------------------------- not ignored
# Deliberately tracked, and worth saying so because they are binaries:
#   IUEA_Teaching_Plan/decks/*.pptx      45 decks, the thing you teach from
#   DataAnalysis_Track/decks/*.pptx      15 decks
#   *.docx, *.xlsx                       guides, plans, workbooks, handouts
#   figs/*.png, DataAnalysis_Track/figs  every figure on every slide
#   DataAnalysis_Track/data/riverside.db the teaching database
#   qr/*.png                             the quiz QR codes
# They are all regenerable from scripts/, but they are also the product, and
# somebody cloning this repo should be able to walk into a room and teach.
