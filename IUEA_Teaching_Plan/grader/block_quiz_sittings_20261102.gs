/** Generated by scripts/apply_block_policy_20261102.py from data/assessment_blocks_20261102.json.
 *  Paste into the Apps Script QUIZ project as a NEW file, next to the regenerated create_quiz_forms.gs.
 *  Needs from create_quiz_forms.gs: openQuizFor, closeQuiz, loadLinks_, saveLinks_, removePending_, QUIZ_DATA, WINDOW_HOURS.
 *
 *  A block quiz is TWO forms opened together in the last 20 minutes of the block's second class:
 *    Block 1 = Week 8 form (Q7) + Week 9 form (Q8), sat in Class 2   (CML3112 Tue 10 Nov, CML3113 and CML3111 Fri 13 Nov)
 *    Block 2 = Week 10 form (Q9) + Week 11 form (Q10), sat in Class 4 (CML3112 Tue 24 Nov, CML3113 and CML3111 Fri 27 Nov)
 *  Each form stays open WINDOW_HOURS (24) and closes itself. The two marks add up to 10. Q11 (Week 12) and Q12 (Week 13) are retired.
 *
 *  Before the sitting:  replaceWeek11Questions() (create_quiz_forms.gs), refreshBlockQuizIntros(), checkBlockQuizForms().
 *  At the sitting:      open_Block1_CML31xx or open_Block2_CML31xx. It refuses to open anything if a form fails the checks.
 *  After:               close_Block1_CML31xx or close_Block2_CML31xx closes both forms early if you want that.
 *  Once:                retireQ11AndQ12Forms() closes the six retired forms. */

var BLOCK_QUIZ_PLAN = {
  "B1": {
    "label": "Block 1",
    "sittingClass": 2,
    "weeks": [
      8,
      9
    ],
    "forms": [
      "Q7",
      "Q8"
    ],
    "plannedDate": {
      "CML3111": "2026-11-13",
      "CML3112": "2026-11-10",
      "CML3113": "2026-11-13"
    },
    "opensLocal": {
      "CML3111": "2026-11-13T13:40:00+03:00",
      "CML3112": "2026-11-10T13:40:00+03:00",
      "CML3113": "2026-11-13T10:40:00+03:00"
    }
  },
  "B2": {
    "label": "Block 2",
    "sittingClass": 4,
    "weeks": [
      10,
      11
    ],
    "forms": [
      "Q9",
      "Q10"
    ],
    "plannedDate": {
      "CML3111": "2026-11-27",
      "CML3112": "2026-11-24",
      "CML3113": "2026-11-27"
    },
    "opensLocal": {
      "CML3111": "2026-11-27T13:40:00+03:00",
      "CML3112": "2026-11-24T13:40:00+03:00",
      "CML3113": "2026-11-27T10:40:00+03:00"
    }
  }
};
var RETIRED_QUIZ_WEEKS_TO_CLOSE = [12, 13];
var BLOCK_COHORTS = ["CML3111", "CML3112", "CML3113"];

/** Checks one form. Returns {problems: [...], warnings: [...]}; the form is ready to be sat when problems is empty. Read-only.
 *  Problems block a sitting: no recorded form, marked retired, wrong number of questions, or (Week 11 only) questions that are not
 *  the replaced ones. Anything else that differs from the bank, such as a title, is a warning and never blocks a sitting. */
function blockFormProblems_(week, code) {
  var problems = [], warnings = [], links = loadLinks_(), L = links[code + '|' + week];
  if (!L) { return {problems: ['no form recorded for ' + code + ' week ' + week], warnings: warnings}; }
  if (L.retired) { problems.push('form is marked retired'); }
  var bank = null, weeks = QUIZ_DATA[code].weeks;
  for (var i = 0; i < weeks.length; i++) { if (weeks[i].week === week) { bank = weeks[i]; } }
  if (!bank) { return {problems: ['no question bank for week ' + week], warnings: warnings}; }
  var form;
  try { form = FormApp.openById(L.formId); } catch (e) { return {problems: ['cannot open the form: ' + e.message], warnings: warnings}; }
  var items = form.getItems(FormApp.ItemType.MULTIPLE_CHOICE);
  if (items.length !== bank.questions.length) {
    problems.push('form has ' + items.length + ' multiple-choice questions, the bank has ' + bank.questions.length);
  } else {
    for (var j = 0; j < items.length; j++) {
      var want = bank.questions[j].n + '. ' + bank.questions[j].title;
      if (items[j].getTitle() !== want) {
        var msg = 'question ' + (j + 1) + ' differs from the bank (form says "' + items[j].getTitle() + '")';
        if (week === 11) { problems.push(msg + '; run replaceWeek11Questions()'); } else { warnings.push(msg); }
      }
    }
  }
  if (form.getTitle() !== bank.title) { warnings.push('title is "' + form.getTitle() + '", the bank says "' + bank.title + '"'); }
  return {problems: problems, warnings: warnings};
}

/** Read-only. Prints OK or the problems for every Block 1 and Block 2 form of every cohort. */
function checkBlockQuizForms() {
  var bad = 0, good = 0;
  BLOCK_COHORTS.forEach(function (code) {
    Object.keys(BLOCK_QUIZ_PLAN).forEach(function (id) {
      BLOCK_QUIZ_PLAN[id].weeks.forEach(function (week, k) {
        var r = blockFormProblems_(week, code), tag = code + ' ' + id + ' ' + BLOCK_QUIZ_PLAN[id].forms[k] + ' (week ' + week + ')';
        if (r.problems.length) { bad++; Logger.log('PROBLEM ' + tag + ': ' + r.problems.join('; ')); }
        else { good++; Logger.log('OK      ' + tag); }
        r.warnings.forEach(function (w) { Logger.log('  warning ' + tag + ': ' + w); });
      });
    });
  });
  Logger.log('checkBlockQuizForms: ' + good + ' OK, ' + bad + ' with problems (expected 12 OK).');
  if (bad) { Logger.log('Fix the problems before the sitting. For the Week 11 form run replaceWeek11Questions().'); }
}

/** Opens both forms of one block for one cohort, all or nothing. */
function openBlockQuizzes_(blockId, code) {
  var plan = BLOCK_QUIZ_PLAN[blockId];
  if (!plan) { throw new Error('Unknown block ' + blockId); }
  var all = [];
  plan.weeks.forEach(function (week) {
    var r = blockFormProblems_(week, code);
    r.problems.forEach(function (p) { all.push('week ' + week + ': ' + p); });
    r.warnings.forEach(function (w) { Logger.log('warning week ' + week + ': ' + w); });
  });
  if (all.length) {
    throw new Error('NOT OPENED. ' + code + ' ' + plan.label + ' has problems: ' + all.join(' | ') + '. Nothing was opened.');
  }
  var planned = plan.plannedDate[code], today = Utilities.formatDate(new Date(), 'Africa/Kampala', 'yyyy-MM-dd');
  if (today !== planned) {
    Logger.log('NOTE: today is ' + today + ' in Kampala but ' + code + ' ' + plan.label + ' is planned for ' + planned + '. Opening anyway.');
  }
  plan.weeks.forEach(function (week) { openQuizFor(week, code); });
  Logger.log('OPENED ' + code + ' ' + plan.label + ': ' + plan.forms.join(' and ') + ' (weeks ' + plan.weeks.join(' and ') + '). Each closes itself after ' + WINDOW_HOURS + ' hours.');
  Logger.log('Give the room the rest of Class ' + plan.sittingClass + ' (about 20 minutes) for both quizzes. Run closeStatus() to see the two close times.');
}

function closeBlockQuizzes_(blockId, code) {
  var plan = BLOCK_QUIZ_PLAN[blockId];
  plan.weeks.forEach(function (week) { closeQuiz(week, code); });
  Logger.log('CLOSED ' + code + ' ' + plan.label + ' (' + plan.forms.join(' and ') + ').');
}

function open_Block1_CML3111() { openBlockQuizzes_('B1', 'CML3111'); }
function open_Block1_CML3112() { openBlockQuizzes_('B1', 'CML3112'); }
function open_Block1_CML3113() { openBlockQuizzes_('B1', 'CML3113'); }
function close_Block1_CML3111() { closeBlockQuizzes_('B1', 'CML3111'); }
function close_Block1_CML3112() { closeBlockQuizzes_('B1', 'CML3112'); }
function close_Block1_CML3113() { closeBlockQuizzes_('B1', 'CML3113'); }
function open_Block2_CML3111() { openBlockQuizzes_('B2', 'CML3111'); }
function open_Block2_CML3112() { openBlockQuizzes_('B2', 'CML3112'); }
function open_Block2_CML3113() { openBlockQuizzes_('B2', 'CML3113'); }
function close_Block2_CML3111() { closeBlockQuizzes_('B2', 'CML3111'); }
function close_Block2_CML3112() { closeBlockQuizzes_('B2', 'CML3112'); }
function close_Block2_CML3113() { closeBlockQuizzes_('B2', 'CML3113'); }

/** Pushes the block wording into the description of the Week 8, 9, 10 and 11 forms. Skips a form that has responses or
 *  is open. The Week 11 form also gets it from replaceWeek11Questions(). */
function refreshBlockQuizIntros() {
  var links = loadLinks_(), done = 0, skipped = 0;
  BLOCK_COHORTS.forEach(function (code) {
    QUIZ_DATA[code].weeks.forEach(function (wk) {
      if ([8, 9, 10, 11].indexOf(wk.week) < 0) { return; }
      var L = links[code + '|' + wk.week];
      if (!L) { Logger.log('no form recorded for ' + code + ' week ' + wk.week); skipped++; return; }
      var form = FormApp.openById(L.formId), n = form.getResponses().length;
      if (n > 0) { Logger.log('SKIPPED ' + code + ' week ' + wk.week + ': it has ' + n + ' responses.'); skipped++; return; }
      if (form.isAcceptingResponses()) { Logger.log('SKIPPED ' + code + ' week ' + wk.week + ': it is open. Close it first.'); skipped++; return; }
      form.setDescription(wk.intro);
      done++;
      Logger.log('description updated: ' + code + ' week ' + wk.week);
    });
  });
  Logger.log('refreshBlockQuizIntros: ' + done + ' updated, ' + skipped + ' skipped (expected 12 updated).');
}

/** Closes the six retired forms (Q11 = week 12, Q12 = week 13, three cohorts), shows a closed-form message, takes them
 *  off the automatic-close list and marks them retired in the link record. Their links and responses are kept. */
function retireQ11AndQ12Forms() {
  var links = loadLinks_(), closed = 0, missing = 0;
  BLOCK_COHORTS.forEach(function (code) {
    RETIRED_QUIZ_WEEKS_TO_CLOSE.forEach(function (week) {
      var key = code + '|' + week, L = links[key];
      if (!L) { Logger.log('no form recorded for ' + key); missing++; return; }
      var form = FormApp.openById(L.formId), n = form.getResponses().length;
      form.setAcceptingResponses(false);
      form.setCustomClosedFormMessage('This quiz is retired. The semester ends at Week 12, so the block quizzes are Q7 and Q8 (Class 2) and Q9 and Q10 (Class 4). Nothing is marked on this form.');
      removePending_(L.formId);
      L.retired = true;
      links[key] = L;
      closed++;
      Logger.log('RETIRED ' + key + ' (' + L.title + '), ' + n + ' responses kept');
    });
  });
  saveLinks_(links);
  Logger.log('retireQ11AndQ12Forms: ' + closed + ' forms closed and retired, ' + missing + ' not found (expected 6 closed, 0 not found).');
  Logger.log('Run closeStatus() to confirm nothing retired is still waiting to close.');
}
