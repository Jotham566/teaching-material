var PANDAS_QUIZ_DATA={"CML3112":{"weeks":[{"week":6,"number":6,"title":"CML3112 \u00b7 Weekly Quiz 6 \u2014 Dirty data, and seeing it","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which entry does the missing-value check identify?","help":"s = pd.Series([0, None, 4])\nprint(s.isna().tolist())","choices":[{"text":"No entries","correct":false},{"text":"Zero and the middle entry","correct":false},{"text":"Only the middle entry","correct":true},{"text":"Every entry","correct":false}],"fbCorrect":"Zero is a recorded number. isna recognises the missing middle entry.","fbWrong":"THE ANSWER: Only the middle entry. Zero is a recorded number. isna recognises the missing middle entry.\n\nWhy the others are wrong. \u201cNo entries\u201d \u2014 pandas recognises the missing marker even if the numeric Series stores it as NaN.  \u201cZero and the middle entry\u201d \u2014 Zero is not automatically missing.  \u201cEvery entry\u201d \u2014 The first and last entries are recorded numbers."},{"n":2,"kind":"diagnosis","title":"What is wrong with this duplicate rule?","help":"Rows are separate observations. Equipment E1 has several valid readings.\nclean = df.drop_duplicates(\"equipment_id\")","choices":[{"text":"It sorts by target","correct":false},{"text":"It keeps every observation","correct":false},{"text":"It fills missing values","correct":false},{"text":"It removes distinct observations from the same equipment","correct":true}],"fbCorrect":"Deduplicate observation IDs under the stated policy, not a source ID that can repeat.","fbWrong":"THE ANSWER: It removes distinct observations from the same equipment. Deduplicate observation IDs under the stated policy, not a source ID that can repeat.\n\nWhy the others are wrong. \u201cIt sorts by target\u201d \u2014 This operation removes rows; it does not sort targets.  \u201cIt keeps every observation\u201d \u2014 It retains only the first row per equipment ID.  \u201cIt fills missing values\u201d \u2014 drop_duplicates does not fill missing fields."},{"n":3,"kind":"traceback","title":"Why does this conversion fail?","help":"pd.to_numeric(pd.Series([\"20\", \"24 C\", \"26\"]))\nValueError: Unable to parse string \"24 C\" at position 1","choices":[{"text":"pandas cannot convert numeric text","correct":false},{"text":"The values must be rounded","correct":false},{"text":"The whole dataset must be deleted","correct":false},{"text":"The second value contains a unit suffix","correct":true}],"fbCorrect":"The value and its position identify what needs inspection before repair.","fbWrong":"THE ANSWER: The second value contains a unit suffix. The value and its position identify what needs inspection before repair.\n\nWhy the others are wrong. \u201cpandas cannot convert numeric text\u201d \u2014 It converts strings such as \"20\".  \u201cThe values must be rounded\u201d \u2014 Rounding cannot remove a text unit suffix.  \u201cThe whole dataset must be deleted\u201d \u2014 Inspect the problematic value; the error does not justify deleting all data."},{"n":4,"kind":"interpretation","title":"What does this fill operation do?","help":"s = pd.Series([20, None, 24, 80])\nfilled = s.fillna(s.median())","choices":[{"text":"It replaces 80 with 24","correct":false},{"text":"It fills the gap with zero","correct":false},{"text":"It inserts 24 for the missing entry and retains 80","correct":true},{"text":"It recovers the true missing measurement","correct":false}],"fbCorrect":"The known values are 20, 24 and 80; the median is 24. fillna changes only missing entries.","fbWrong":"THE ANSWER: It inserts 24 for the missing entry and retains 80. The known values are 20, 24 and 80; the median is 24. fillna changes only missing entries.\n\nWhy the others are wrong. \u201cIt replaces 80 with 24\u201d \u2014 An extreme recorded value is not a missing value.  \u201cIt fills the gap with zero\u201d \u2014 The supplied fill is the median, not zero.  \u201cIt recovers the true missing measurement\u201d \u2014 The fill is an estimate, not a recovered observation."},{"n":5,"kind":"judgement","title":"Which output answers the question?","help":"Question: Do mean target values differ by equipment?","choices":[{"text":"A chart with no labels","correct":false},{"text":"A labelled chart of groupby(\"equipment_id\")[\"target\"].mean()","correct":true},{"text":"The total row count alone","correct":false},{"text":"One histogram of all targets","correct":false}],"fbCorrect":"Grouped means compare the requested equipment groups.","fbWrong":"THE ANSWER: A labelled chart of groupby(\"equipment_id\")[\"target\"].mean(). Grouped means compare the requested equipment groups.\n\nWhy the others are wrong. \u201cA chart with no labels\u201d \u2014 Without groups and units, the comparison cannot be interpreted.  \u201cThe total row count alone\u201d \u2014 A count does not compare target means.  \u201cOne histogram of all targets\u201d \u2014 A pooled histogram describes a distribution without comparing group means."}]},{"week":8,"number":7,"title":"CML3112 \u00b7 Weekly Quiz 7 \u2014 Learning from data: the first model","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"What shape does X need here?","help":"features = [\"load_pct\", \"ambient_c\"]\nX = train[features]\ny = train[\"target\"]","choices":[{"text":"One row per training observation and two feature columns","correct":true},{"text":"One unrelated row for each target","correct":false},{"text":"Two rows regardless of dataset size","correct":false},{"text":"A column containing the target only","correct":false}],"fbCorrect":"The two named features form a table; y has a target for each same row.","fbWrong":"THE ANSWER: One row per training observation and two feature columns. The two named features form a table; y has a target for each same row.\n\nWhy the others are wrong. \u201cOne unrelated row for each target\u201d \u2014 Features and targets must refer to matching observations.  \u201cTwo rows regardless of dataset size\u201d \u2014 Two is the feature count, not the observation count.  \u201cA column containing the target only\u201d \u2014 The target is y, not a predictor."},{"n":2,"kind":"diagnosis","title":"Why should prediction use new[features]?","help":"model.fit(train[features], train[\"target\"])","choices":[{"text":"It trains the model again","correct":false},{"text":"It guarantees accurate predictions","correct":false},{"text":"It supplies the new true target","correct":false},{"text":"It keeps the same feature names and order as training","correct":true}],"fbCorrect":"Names and order preserve the meaning of each model input.","fbWrong":"THE ANSWER: It keeps the same feature names and order as training. Names and order preserve the meaning of each model input.\n\nWhy the others are wrong. \u201cIt trains the model again\u201d \u2014 predict uses the fitted model; it does not fit it.  \u201cIt guarantees accurate predictions\u201d \u2014 Consistent inputs are necessary but do not guarantee accuracy.  \u201cIt supplies the new true target\u201d \u2014 Feature inputs must not contain the answer."},{"n":3,"kind":"traceback","title":"What should you check first?","help":"model.fit(X, y)\nValueError: Found input variables with inconsistent numbers of samples","choices":[{"text":"Whether X and y were selected from the same rows","correct":true},{"text":"Round all columns","correct":false},{"text":"Delete target values at random","correct":false},{"text":"Increase tree depth","correct":false}],"fbCorrect":"Separate filtering can leave different observation counts or mismatched rows.","fbWrong":"THE ANSWER: Whether X and y were selected from the same rows. Separate filtering can leave different observation counts or mismatched rows.\n\nWhy the others are wrong. \u201cRound all columns\u201d \u2014 Rounding does not change the number of observations.  \u201cDelete target values at random\u201d \u2014 This breaks pairing and loses valid data.  \u201cIncrease tree depth\u201d \u2014 Model complexity does not repair mismatched inputs."},{"n":4,"kind":"interpretation","title":"What are MAE and RMSE?","help":"actual = [10, 20]\npredicted = [12, 16]","choices":[{"text":"Both are percentages","correct":false},{"text":"MAE 3; RMSE approximately 3.1623","correct":true},{"text":"Both are 6","correct":false},{"text":"MAE -1; RMSE 1","correct":false}],"fbCorrect":"Absolute errors are 2 and 4; squared errors are 4 and 16.","fbWrong":"THE ANSWER: MAE 3; RMSE approximately 3.1623. Absolute errors are 2 and 4; squared errors are 4 and 16.\n\nWhy the others are wrong. \u201cBoth are percentages\u201d \u2014 These errors use the target unit.  \u201cBoth are 6\u201d \u2014 Six is the total absolute error, not its mean.  \u201cMAE -1; RMSE 1\u201d \u2014 MAE uses absolute errors, so signed cancellation is wrong."},{"n":5,"kind":"judgement","title":"Where should the imputer learn its median?","help":"Training, validation and final-test partitions are already separate.","choices":[{"text":"Each new prediction row independently","correct":false},{"text":"Training features only","correct":true},{"text":"Validation targets","correct":false},{"text":"The combined file","correct":false}],"fbCorrect":"The fitted fill must be reused on evaluation data without learning from them.","fbWrong":"THE ANSWER: Training features only. The fitted fill must be reused on evaluation data without learning from them.\n\nWhy the others are wrong. \u201cEach new prediction row independently\u201d \u2014 This changes preprocessing at prediction time.  \u201cValidation targets\u201d \u2014 Targets cannot supply predictor fill values.  \u201cThe combined file\u201d \u2014 That uses evaluation information in preprocessing."}]},{"week":9,"number":8,"title":"CML3112 \u00b7 Weekly Quiz 8 \u2014 Classification","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"How many false negatives are present?","help":"actual    = [1, 1, 0, 0]\npredicted = [1, 0, 1, 0]","choices":[{"text":"2","correct":false},{"text":"4","correct":false},{"text":"1","correct":true},{"text":"0","correct":false}],"fbCorrect":"Only the second row needs a warning but receives none.","fbWrong":"THE ANSWER: 1. Only the second row needs a warning but receives none.\n\nWhy the others are wrong. \u201c2\u201d \u2014 There are two errors, but only one is a false negative.  \u201c4\u201d \u2014 Every row is not an error.  \u201c0\u201d \u2014 The second row is a missed warning."},{"n":2,"kind":"diagnosis","title":"Why is high accuracy insufficient here?","help":"Only 2% of observations need a warning. A model always predicts 0.","choices":[{"text":"The dataset has no positive observations","correct":false},{"text":"It detects all warnings","correct":false},{"text":"It must have perfect recall","correct":false},{"text":"It misses every actual warning","correct":true}],"fbCorrect":"Predicting the majority can give 98% accuracy while recall is zero.","fbWrong":"THE ANSWER: It misses every actual warning. Predicting the majority can give 98% accuracy while recall is zero.\n\nWhy the others are wrong. \u201cThe dataset has no positive observations\u201d \u2014 Two percent are positives.  \u201cIt detects all warnings\u201d \u2014 It predicts no warnings at all.  \u201cIt must have perfect recall\u201d \u2014 Recall counts detected positives, not correct negatives."},{"n":3,"kind":"traceback","title":"How should this assignment avoid the error?","help":"precision = tp / (tp + fp)\nZeroDivisionError: division by zero","choices":[{"text":"Use the target unit as denominator","correct":false},{"text":"Return 0 when tp + fp is zero, as specified","correct":true},{"text":"Delete the entire dataset","correct":false},{"text":"Invent one true positive","correct":false}],"fbCorrect":"The published convention handles the no-predicted-warning case.","fbWrong":"THE ANSWER: Return 0 when tp + fp is zero, as specified. The published convention handles the no-predicted-warning case.\n\nWhy the others are wrong. \u201cUse the target unit as denominator\u201d \u2014 Units are not observation counts.  \u201cDelete the entire dataset\u201d \u2014 A zero denominator needs a convention, not deletion.  \u201cInvent one true positive\u201d \u2014 That changes the evidence."},{"n":4,"kind":"interpretation","title":"What is the cost under this rule?","help":"Missed warning costs 5; false alarm costs 1.\nfn = 2; fp = 3","choices":[{"text":"6","correct":false},{"text":"5","correct":false},{"text":"25","correct":false},{"text":"13","correct":true}],"fbCorrect":"5 times 2 plus 3 is 13.","fbWrong":"THE ANSWER: 13. 5 times 2 plus 3 is 13.\n\nWhy the others are wrong. \u201c6\u201d \u2014 Multiplying the two counts is not the stated rule.  \u201c5\u201d \u2014 This ignores the supplied error counts.  \u201c25\u201d \u2014 The costs are not both five."},{"n":5,"kind":"judgement","title":"What can lowering the threshold change?","help":"Probabilities stay fixed; threshold falls from 0.5 to 0.3.","choices":[{"text":"It changes the actual labels","correct":false},{"text":"More observations can be classified as warnings","correct":true},{"text":"It guarantees fewer false alarms","correct":false},{"text":"It retrains the model automatically","correct":false}],"fbCorrect":"The decision rule changes; actual labels are needed to assess its errors.","fbWrong":"THE ANSWER: More observations can be classified as warnings. The decision rule changes; actual labels are needed to assess its errors.\n\nWhy the others are wrong. \u201cIt changes the actual labels\u201d \u2014 The reference outcomes stay fixed.  \u201cIt guarantees fewer false alarms\u201d \u2014 Raising more warnings can increase false alarms.  \u201cIt retrains the model automatically\u201d \u2014 Thresholding does not fit model parameters."}]},{"week":10,"number":9,"title":"CML3112 \u00b7 Weekly Quiz 9 \u2014 Can I trust this model?","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Why keep an equipment ID in only one partition?","help":"The intended deployment is on previously unseen equipment.","choices":[{"text":"To delete repeated valid observations","correct":false},{"text":"To make every partition equally large","correct":false},{"text":"To use the target as a group label","correct":false},{"text":"To avoid evaluating on equipment patterns already seen in training","correct":true}],"fbCorrect":"Repeated observations from one source can make evaluation too optimistic.","fbWrong":"THE ANSWER: To avoid evaluating on equipment patterns already seen in training. Repeated observations from one source can make evaluation too optimistic.\n\nWhy the others are wrong. \u201cTo delete repeated valid observations\u201d \u2014 Repeated observations can be valid and remain in their group.  \u201cTo make every partition equally large\u201d \u2014 Group separation does not guarantee equal counts.  \u201cTo use the target as a group label\u201d \u2014 Equipment identity, not the answer, defines this split."},{"n":2,"kind":"diagnosis","title":"What is wrong with this preparation?","help":"median = all_rows[\"ambient_c\"].median()\n# split into training and validation afterwards","choices":[{"text":"It guarantees underfitting","correct":false},{"text":"It uses validation information when learning a fill value","correct":true},{"text":"pandas cannot calculate medians","correct":false},{"text":"A median is never allowed","correct":false}],"fbCorrect":"Split first and fit preprocessing on training only.","fbWrong":"THE ANSWER: It uses validation information when learning a fill value. Split first and fit preprocessing on training only.\n\nWhy the others are wrong. \u201cIt guarantees underfitting\u201d \u2014 The direct problem is information leakage.  \u201cpandas cannot calculate medians\u201d \u2014 It can; the problem is which rows it uses.  \u201cA median is never allowed\u201d \u2014 Training-only median imputation is allowed when justified."},{"n":3,"kind":"traceback","title":"Why might prediction still fail with missing inputs?","help":"A pipeline contains only a regression model.\nValueError: Input X contains NaN.","choices":[{"text":"The warning should be ignored","correct":false},{"text":"The final-test target must be added to X","correct":false},{"text":"All values should become zero","correct":false},{"text":"The pipeline needs appropriate missing-feature preparation","correct":true}],"fbCorrect":"Include the trained imputer before the model and fit it on training data.","fbWrong":"THE ANSWER: The pipeline needs appropriate missing-feature preparation. Include the trained imputer before the model and fit it on training data.\n\nWhy the others are wrong. \u201cThe warning should be ignored\u201d \u2014 Ignoring an error does not supply usable inputs.  \u201cThe final-test target must be added to X\u201d \u2014 That would leak the answer.  \u201cAll values should become zero\u201d \u2014 Zero filling needs a justified policy and may distort data."},{"n":4,"kind":"interpretation","title":"What does this output show?","help":"Training median = 22.\nValidation values [None, 40] become [22, 40].","choices":[{"text":"Every value was changed","correct":false},{"text":"The validation median was fitted","correct":false},{"text":"The training fill was reused on validation","correct":true},{"text":"The missing measurement was recovered","correct":false}],"fbCorrect":"Validation 40 did not determine a separate fill.","fbWrong":"THE ANSWER: The training fill was reused on validation. Validation 40 did not determine a separate fill.\n\nWhy the others are wrong. \u201cEvery value was changed\u201d \u2014 The recorded 40 remains unchanged.  \u201cThe validation median was fitted\u201d \u2014 The given rule uses the training median.  \u201cThe missing measurement was recovered\u201d \u2014 It is an estimate."},{"n":5,"kind":"judgement","title":"What should be reported for several validation folds?","help":"Errors vary noticeably across folds.","choices":[{"text":"A claim of guaranteed future performance","correct":false},{"text":"The mean, variation and any important differences between folds","correct":true},{"text":"Only the best fold","correct":false},{"text":"Only the training score","correct":false}],"fbCorrect":"The best fold alone hides unstable performance.","fbWrong":"THE ANSWER: The mean, variation and any important differences between folds. The best fold alone hides unstable performance.\n\nWhy the others are wrong. \u201cA claim of guaranteed future performance\u201d \u2014 Finite validation evidence cannot guarantee future errors.  \u201cOnly the best fold\u201d \u2014 This cherry-picks the evaluation.  \u201cOnly the training score\u201d \u2014 That does not describe held-out folds."}]},{"week":11,"number":10,"title":"CML3112 \u00b7 Weekly Quiz 10 \u2014 Features","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which values are produced?","help":"load_pct = 40; ambient_c = 25\nload_fraction = load_pct / 100\ninteraction = load_pct * ambient_c","choices":[{"text":"0.4 and 65","correct":false},{"text":"40 and 65","correct":false},{"text":"0.4 and 1000","correct":true},{"text":"4000 and 1.6","correct":false}],"fbCorrect":"Division converts percent to a fraction; multiplication creates the interaction.","fbWrong":"THE ANSWER: 0.4 and 1000. Division converts percent to a fraction; multiplication creates the interaction.\n\nWhy the others are wrong. \u201c0.4 and 65\u201d \u2014 An interaction here is a product, not a sum.  \u201c40 and 65\u201d \u2014 The first needs division and the second multiplication.  \u201c4000 and 1.6\u201d \u2014 These use different operations."},{"n":2,"kind":"diagnosis","title":"Why is this feature invalid for prediction?","help":"new_feature = future_target / load_pct","choices":[{"text":"It uses the answer that is unavailable at prediction time","correct":true},{"text":"pandas cannot divide columns","correct":false},{"text":"It has a short name","correct":false},{"text":"Ratios are always invalid","correct":false}],"fbCorrect":"A predictor must be obtainable before the target is known.","fbWrong":"THE ANSWER: It uses the answer that is unavailable at prediction time. A predictor must be obtainable before the target is known.\n\nWhy the others are wrong. \u201cpandas cannot divide columns\u201d \u2014 It can perform column arithmetic.  \u201cIt has a short name\u201d \u2014 Naming is not the leakage issue.  \u201cRatios are always invalid\u201d \u2014 Ratios of available inputs can be useful."},{"n":3,"kind":"traceback","title":"What does this error suggest?","help":"valid[\"interaction\"]\nKeyError: 'interaction'","choices":[{"text":"Round the validation data","correct":false},{"text":"The model has too many rows","correct":false},{"text":"Fit on validation targets","correct":false},{"text":"The column has not been created under that name in valid","correct":true}],"fbCorrect":"Apply the same named feature preparation to training and validation.","fbWrong":"THE ANSWER: The column has not been created under that name in valid. Apply the same named feature preparation to training and validation.\n\nWhy the others are wrong. \u201cRound the validation data\u201d \u2014 Rounding does not create the column.  \u201cThe model has too many rows\u201d \u2014 This error concerns a missing key or label.  \u201cFit on validation targets\u201d \u2014 That leaks evaluation answers."},{"n":4,"kind":"interpretation","title":"What is the improvement?","help":"base_mae = 3.0; extended_mae = 2.5\nimprovement = base_mae - extended_mae","choices":[{"text":"0.5 in the target unit","correct":true},{"text":"0.5 percent in every case","correct":false},{"text":"A guarantee every prediction improved","correct":false},{"text":"-0.5","correct":false}],"fbCorrect":"The extended model reduces mean absolute error by 0.5.","fbWrong":"THE ANSWER: 0.5 in the target unit. The extended model reduces mean absolute error by 0.5.\n\nWhy the others are wrong. \u201c0.5 percent in every case\u201d \u2014 MAE uses the target unit, not an automatic percentage.  \u201cA guarantee every prediction improved\u201d \u2014 An average improvement does not guarantee each row improved.  \u201c-0.5\u201d \u2014 That reverses the stated subtraction."},{"n":5,"kind":"judgement","title":"What makes the comparison meaningful?","help":"Compare base features with base features plus an interaction.","choices":[{"text":"Use final-test scores to keep trying features","correct":false},{"text":"Choose a different easy validation set","correct":false},{"text":"Use the same training and validation rows and model protocol","correct":true},{"text":"Always prefer the larger feature set","correct":false}],"fbCorrect":"Changing only the feature set makes the difference interpretable.","fbWrong":"THE ANSWER: Use the same training and validation rows and model protocol. Changing only the feature set makes the difference interpretable.\n\nWhy the others are wrong. \u201cUse final-test scores to keep trying features\u201d \u2014 That turns the final test into selection data.  \u201cChoose a different easy validation set\u201d \u2014 That confounds the comparison.  \u201cAlways prefer the larger feature set\u201d \u2014 More features can fail to improve generalisation."}]},{"week":12,"number":11,"title":"CML3112 \u00b7 Weekly Quiz 11 \u2014 Model comparison (integrative)","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which candidate meets both constraints?","help":"Limits: MAE <= 3 and latency <= 10 ms.\nsimple: MAE 3, latency 2\ncomplex: MAE 1, latency 20","choices":[{"text":"complex","correct":false},{"text":"simple","correct":true},{"text":"Both","correct":false},{"text":"Neither","correct":false}],"fbCorrect":"It satisfies both inclusive limits.","fbWrong":"THE ANSWER: simple. It satisfies both inclusive limits.\n\nWhy the others are wrong. \u201ccomplex\u201d \u2014 Its latency fails the requirement.  \u201cBoth\u201d \u2014 complex fails the latency limit.  \u201cNeither\u201d \u2014 simple meets the limits, including equality on MAE."},{"n":2,"kind":"diagnosis","title":"What is wrong with choosing the lowest error before filtering?","help":"One very accurate candidate exceeds the permitted latency.","choices":[{"text":"The chosen candidate may be ineligible","correct":true},{"text":"Sorting cannot be used","correct":false},{"text":"Latency and error must be added","correct":false},{"text":"All constraints should be dropped","correct":false}],"fbCorrect":"Check every constraint before ranking eligible candidates.","fbWrong":"THE ANSWER: The chosen candidate may be ineligible. Check every constraint before ranking eligible candidates.\n\nWhy the others are wrong. \u201cSorting cannot be used\u201d \u2014 Sorting is useful after eligibility filtering.  \u201cLatency and error must be added\u201d \u2014 They have different meanings and the policy does not add them.  \u201cAll constraints should be dropped\u201d \u2014 That changes the requirements."},{"n":3,"kind":"traceback","title":"What check prevents this error?","help":"winner = eligible.iloc[0][\"name\"]\nIndexError: single positional indexer is out-of-bounds","choices":[{"text":"Always pick the original first candidate","correct":false},{"text":"Delete the latency column","correct":false},{"text":"Check eligible.empty and return None if no rows remain","correct":true},{"text":"Use iloc[1] instead","correct":false}],"fbCorrect":"There is no first row in an empty table.","fbWrong":"THE ANSWER: Check eligible.empty and return None if no rows remain. There is no first row in an empty table.\n\nWhy the others are wrong. \u201cAlways pick the original first candidate\u201d \u2014 That can choose an ineligible model.  \u201cDelete the latency column\u201d \u2014 Removing evidence does not satisfy the constraints.  \u201cUse iloc[1] instead\u201d \u2014 An empty table has no second row either."},{"n":4,"kind":"interpretation","title":"Which name wins the published tie-break?","help":"Both candidates have MAE 2 and latency 3 ms.\nNames: beta, alpha\nSort by error, latency, then name.","choices":[{"text":"Whichever appeared last","correct":false},{"text":"beta","correct":false},{"text":"alpha","correct":true},{"text":"None","correct":false}],"fbCorrect":"With equal numerical criteria, alphabetical name order decides.","fbWrong":"THE ANSWER: alpha. With equal numerical criteria, alphabetical name order decides.\n\nWhy the others are wrong. \u201cWhichever appeared last\u201d \u2014 Input order is not the stated tie-break.  \u201cbeta\u201d \u2014 That is not the alphabetical first name.  \u201cNone\u201d \u2014 Both are eligible and the tie-break resolves the choice."},{"n":5,"kind":"judgement","title":"Which data should guide model selection?","help":"The final test is reserved for the fixed choice.","choices":[{"text":"Final-test results after every trial","correct":false},{"text":"The nicest-looking training plot","correct":false},{"text":"The largest number of parameters","correct":false},{"text":"Validation results under a consistent protocol","correct":true}],"fbCorrect":"The final test should remain independent of repeated choices.","fbWrong":"THE ANSWER: Validation results under a consistent protocol. The final test should remain independent of repeated choices.\n\nWhy the others are wrong. \u201cFinal-test results after every trial\u201d \u2014 Repeated selection on those results uses up the final test.  \u201cThe nicest-looking training plot\u201d \u2014 Appearance does not establish held-out performance.  \u201cThe largest number of parameters\u201d \u2014 Complexity alone does not establish quality."}]},{"week":13,"number":12,"title":"CML3112 \u00b7 Weekly Quiz 12 \u2014 Reproducibility (integrative)","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Why use a relative CSV path?","help":"pd.read_csv(\"data/raw/engineering_data.csv\")","choices":[{"text":"It can work on another computer with the same project structure","correct":true},{"text":"It encrypts the data","correct":false},{"text":"It downloads the file automatically","correct":false},{"text":"It makes raw data safe to overwrite","correct":false}],"fbCorrect":"Document the working folder and include the expected data layout.","fbWrong":"THE ANSWER: It can work on another computer with the same project structure. Document the working folder and include the expected data layout.\n\nWhy the others are wrong. \u201cIt encrypts the data\u201d \u2014 Path choice does not provide encryption.  \u201cIt downloads the file automatically\u201d \u2014 A local relative path does not fetch missing files.  \u201cIt makes raw data safe to overwrite\u201d \u2014 Raw data should still be preserved."},{"n":2,"kind":"diagnosis","title":"What is wrong with trusting a saved output?","help":"A notebook displays a chart but fails after Restart and Run All.","choices":[{"text":"The chart proves the current code works","correct":false},{"text":"Restarting changes the dataset by itself","correct":false},{"text":"The visible output may come from an earlier session","correct":true},{"text":"Only the chart title matters","correct":false}],"fbCorrect":"A fresh run checks whether the saved code and supplied files reproduce it.","fbWrong":"THE ANSWER: The visible output may come from an earlier session. A fresh run checks whether the saved code and supplied files reproduce it.\n\nWhy the others are wrong. \u201cThe chart proves the current code works\u201d \u2014 It may have been saved before the code changed.  \u201cRestarting changes the dataset by itself\u201d \u2014 The issue may be missing state or files, not a changed dataset.  \u201cOnly the chart title matters\u201d \u2014 Reproducibility needs executable steps and data."},{"n":3,"kind":"traceback","title":"What should be checked first?","help":"pd.read_csv(\"data/raw/engineering_data.csv\")\nFileNotFoundError","choices":[{"text":"Rewrite the analysis using csv.DictReader","correct":false},{"text":"Change the model hyperparameters","correct":false},{"text":"The working folder, relative path and supplied filename","correct":true},{"text":"Delete all other files","correct":false}],"fbCorrect":"Confirm the file is present at the path used by the notebook.","fbWrong":"THE ANSWER: The working folder, relative path and supplied filename. Confirm the file is present at the path used by the notebook.\n\nWhy the others are wrong. \u201cRewrite the analysis using csv.DictReader\u201d \u2014 Changing libraries does not repair a missing file.  \u201cChange the model hyperparameters\u201d \u2014 Model settings do not affect file discovery.  \u201cDelete all other files\u201d \u2014 That does not create the required file."},{"n":4,"kind":"interpretation","title":"What does index=False do?","help":"clean.to_csv(\"cleaned_data.csv\", index=False)","choices":[{"text":"It fills missing values","correct":false},{"text":"It removes the first observation","correct":false},{"text":"It prevents saving","correct":false},{"text":"It omits pandas row labels from the exported CSV columns","correct":true}],"fbCorrect":"The data columns remain in the file.","fbWrong":"THE ANSWER: It omits pandas row labels from the exported CSV columns. The data columns remain in the file.\n\nWhy the others are wrong. \u201cIt fills missing values\u201d \u2014 Export options do not perform imputation.  \u201cIt removes the first observation\u201d \u2014 It controls row labels, not the first data row.  \u201cIt prevents saving\u201d \u2014 to_csv still writes the file."},{"n":5,"kind":"judgement","title":"What belongs in a reproducible handover?","help":"Another person must run the work from a fresh session.","choices":[{"text":"Only the final score","correct":false},{"text":"Only screenshots","correct":false},{"text":"Data paths, dependencies, run order, units and limitations","correct":true},{"text":"Private machine paths with no instructions","correct":false}],"fbCorrect":"These explain what is needed and what the results support.","fbWrong":"THE ANSWER: Data paths, dependencies, run order, units and limitations. These explain what is needed and what the results support.\n\nWhy the others are wrong. \u201cOnly the final score\u201d \u2014 A score does not explain data, methods or limitations.  \u201cOnly screenshots\u201d \u2014 Screenshots cannot reproduce the calculations.  \u201cPrivate machine paths with no instructions\u201d \u2014 Those paths generally fail on another computer."}]}]},"CML3113":{"weeks":[{"week":6,"number":6,"title":"CML3113 \u00b7 Weekly Quiz 6 \u2014 Dirty data, and seeing it","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which entry does the missing-value check identify?","help":"s = pd.Series([0, None, 4])\nprint(s.isna().tolist())","choices":[{"text":"Zero and the middle entry","correct":false},{"text":"No entries","correct":false},{"text":"Every entry","correct":false},{"text":"Only the middle entry","correct":true}],"fbCorrect":"Zero is a recorded number. isna recognises the missing middle entry.","fbWrong":"THE ANSWER: Only the middle entry. Zero is a recorded number. isna recognises the missing middle entry.\n\nWhy the others are wrong. \u201cZero and the middle entry\u201d \u2014 Zero is not automatically missing.  \u201cNo entries\u201d \u2014 pandas recognises the missing marker even if the numeric Series stores it as NaN.  \u201cEvery entry\u201d \u2014 The first and last entries are recorded numbers."},{"n":2,"kind":"diagnosis","title":"What is wrong with this duplicate rule?","help":"Rows are separate observations. Equipment E1 has several valid readings.\nclean = df.drop_duplicates(\"equipment_id\")","choices":[{"text":"It removes distinct observations from the same equipment","correct":true},{"text":"It keeps every observation","correct":false},{"text":"It fills missing values","correct":false},{"text":"It sorts by target","correct":false}],"fbCorrect":"Deduplicate observation IDs under the stated policy, not a source ID that can repeat.","fbWrong":"THE ANSWER: It removes distinct observations from the same equipment. Deduplicate observation IDs under the stated policy, not a source ID that can repeat.\n\nWhy the others are wrong. \u201cIt keeps every observation\u201d \u2014 It retains only the first row per equipment ID.  \u201cIt fills missing values\u201d \u2014 drop_duplicates does not fill missing fields.  \u201cIt sorts by target\u201d \u2014 This operation removes rows; it does not sort targets."},{"n":3,"kind":"traceback","title":"Why does this conversion fail?","help":"pd.to_numeric(pd.Series([\"20\", \"24 C\", \"26\"]))\nValueError: Unable to parse string \"24 C\" at position 1","choices":[{"text":"The second value contains a unit suffix","correct":true},{"text":"The values must be rounded","correct":false},{"text":"pandas cannot convert numeric text","correct":false},{"text":"The whole dataset must be deleted","correct":false}],"fbCorrect":"The value and its position identify what needs inspection before repair.","fbWrong":"THE ANSWER: The second value contains a unit suffix. The value and its position identify what needs inspection before repair.\n\nWhy the others are wrong. \u201cThe values must be rounded\u201d \u2014 Rounding cannot remove a text unit suffix.  \u201cpandas cannot convert numeric text\u201d \u2014 It converts strings such as \"20\".  \u201cThe whole dataset must be deleted\u201d \u2014 Inspect the problematic value; the error does not justify deleting all data."},{"n":4,"kind":"interpretation","title":"What does this fill operation do?","help":"s = pd.Series([20, None, 24, 80])\nfilled = s.fillna(s.median())","choices":[{"text":"It recovers the true missing measurement","correct":false},{"text":"It replaces 80 with 24","correct":false},{"text":"It inserts 24 for the missing entry and retains 80","correct":true},{"text":"It fills the gap with zero","correct":false}],"fbCorrect":"The known values are 20, 24 and 80; the median is 24. fillna changes only missing entries.","fbWrong":"THE ANSWER: It inserts 24 for the missing entry and retains 80. The known values are 20, 24 and 80; the median is 24. fillna changes only missing entries.\n\nWhy the others are wrong. \u201cIt recovers the true missing measurement\u201d \u2014 The fill is an estimate, not a recovered observation.  \u201cIt replaces 80 with 24\u201d \u2014 An extreme recorded value is not a missing value.  \u201cIt fills the gap with zero\u201d \u2014 The supplied fill is the median, not zero."},{"n":5,"kind":"judgement","title":"Which output answers the question?","help":"Question: Do mean target values differ by equipment?","choices":[{"text":"A labelled chart of groupby(\"equipment_id\")[\"target\"].mean()","correct":true},{"text":"A chart with no labels","correct":false},{"text":"The total row count alone","correct":false},{"text":"One histogram of all targets","correct":false}],"fbCorrect":"Grouped means compare the requested equipment groups.","fbWrong":"THE ANSWER: A labelled chart of groupby(\"equipment_id\")[\"target\"].mean(). Grouped means compare the requested equipment groups.\n\nWhy the others are wrong. \u201cA chart with no labels\u201d \u2014 Without groups and units, the comparison cannot be interpreted.  \u201cThe total row count alone\u201d \u2014 A count does not compare target means.  \u201cOne histogram of all targets\u201d \u2014 A pooled histogram describes a distribution without comparing group means."}]},{"week":8,"number":7,"title":"CML3113 \u00b7 Weekly Quiz 7 \u2014 Learning from data: the first model","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"What shape does X need here?","help":"features = [\"load_pct\", \"ambient_c\"]\nX = train[features]\ny = train[\"target\"]","choices":[{"text":"Two rows regardless of dataset size","correct":false},{"text":"One unrelated row for each target","correct":false},{"text":"A column containing the target only","correct":false},{"text":"One row per training observation and two feature columns","correct":true}],"fbCorrect":"The two named features form a table; y has a target for each same row.","fbWrong":"THE ANSWER: One row per training observation and two feature columns. The two named features form a table; y has a target for each same row.\n\nWhy the others are wrong. \u201cTwo rows regardless of dataset size\u201d \u2014 Two is the feature count, not the observation count.  \u201cOne unrelated row for each target\u201d \u2014 Features and targets must refer to matching observations.  \u201cA column containing the target only\u201d \u2014 The target is y, not a predictor."},{"n":2,"kind":"diagnosis","title":"Why should prediction use new[features]?","help":"model.fit(train[features], train[\"target\"])","choices":[{"text":"It guarantees accurate predictions","correct":false},{"text":"It trains the model again","correct":false},{"text":"It supplies the new true target","correct":false},{"text":"It keeps the same feature names and order as training","correct":true}],"fbCorrect":"Names and order preserve the meaning of each model input.","fbWrong":"THE ANSWER: It keeps the same feature names and order as training. Names and order preserve the meaning of each model input.\n\nWhy the others are wrong. \u201cIt guarantees accurate predictions\u201d \u2014 Consistent inputs are necessary but do not guarantee accuracy.  \u201cIt trains the model again\u201d \u2014 predict uses the fitted model; it does not fit it.  \u201cIt supplies the new true target\u201d \u2014 Feature inputs must not contain the answer."},{"n":3,"kind":"traceback","title":"What should you check first?","help":"model.fit(X, y)\nValueError: Found input variables with inconsistent numbers of samples","choices":[{"text":"Whether X and y were selected from the same rows","correct":true},{"text":"Delete target values at random","correct":false},{"text":"Round all columns","correct":false},{"text":"Increase tree depth","correct":false}],"fbCorrect":"Separate filtering can leave different observation counts or mismatched rows.","fbWrong":"THE ANSWER: Whether X and y were selected from the same rows. Separate filtering can leave different observation counts or mismatched rows.\n\nWhy the others are wrong. \u201cDelete target values at random\u201d \u2014 This breaks pairing and loses valid data.  \u201cRound all columns\u201d \u2014 Rounding does not change the number of observations.  \u201cIncrease tree depth\u201d \u2014 Model complexity does not repair mismatched inputs."},{"n":4,"kind":"interpretation","title":"What are MAE and RMSE?","help":"actual = [10, 20]\npredicted = [12, 16]","choices":[{"text":"Both are 6","correct":false},{"text":"MAE -1; RMSE 1","correct":false},{"text":"MAE 3; RMSE approximately 3.1623","correct":true},{"text":"Both are percentages","correct":false}],"fbCorrect":"Absolute errors are 2 and 4; squared errors are 4 and 16.","fbWrong":"THE ANSWER: MAE 3; RMSE approximately 3.1623. Absolute errors are 2 and 4; squared errors are 4 and 16.\n\nWhy the others are wrong. \u201cBoth are 6\u201d \u2014 Six is the total absolute error, not its mean.  \u201cMAE -1; RMSE 1\u201d \u2014 MAE uses absolute errors, so signed cancellation is wrong.  \u201cBoth are percentages\u201d \u2014 These errors use the target unit."},{"n":5,"kind":"judgement","title":"Where should the imputer learn its median?","help":"Training, validation and final-test partitions are already separate.","choices":[{"text":"Each new prediction row independently","correct":false},{"text":"Training features only","correct":true},{"text":"The combined file","correct":false},{"text":"Validation targets","correct":false}],"fbCorrect":"The fitted fill must be reused on evaluation data without learning from them.","fbWrong":"THE ANSWER: Training features only. The fitted fill must be reused on evaluation data without learning from them.\n\nWhy the others are wrong. \u201cEach new prediction row independently\u201d \u2014 This changes preprocessing at prediction time.  \u201cThe combined file\u201d \u2014 That uses evaluation information in preprocessing.  \u201cValidation targets\u201d \u2014 Targets cannot supply predictor fill values."}]},{"week":9,"number":8,"title":"CML3113 \u00b7 Weekly Quiz 8 \u2014 Classification","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"How many false negatives are present?","help":"actual    = [1, 1, 0, 0]\npredicted = [1, 0, 1, 0]","choices":[{"text":"4","correct":false},{"text":"2","correct":false},{"text":"1","correct":true},{"text":"0","correct":false}],"fbCorrect":"Only the second row needs a warning but receives none.","fbWrong":"THE ANSWER: 1. Only the second row needs a warning but receives none.\n\nWhy the others are wrong. \u201c4\u201d \u2014 Every row is not an error.  \u201c2\u201d \u2014 There are two errors, but only one is a false negative.  \u201c0\u201d \u2014 The second row is a missed warning."},{"n":2,"kind":"diagnosis","title":"Why is high accuracy insufficient here?","help":"Only 2% of observations need a warning. A model always predicts 0.","choices":[{"text":"It misses every actual warning","correct":true},{"text":"The dataset has no positive observations","correct":false},{"text":"It must have perfect recall","correct":false},{"text":"It detects all warnings","correct":false}],"fbCorrect":"Predicting the majority can give 98% accuracy while recall is zero.","fbWrong":"THE ANSWER: It misses every actual warning. Predicting the majority can give 98% accuracy while recall is zero.\n\nWhy the others are wrong. \u201cThe dataset has no positive observations\u201d \u2014 Two percent are positives.  \u201cIt must have perfect recall\u201d \u2014 Recall counts detected positives, not correct negatives.  \u201cIt detects all warnings\u201d \u2014 It predicts no warnings at all."},{"n":3,"kind":"traceback","title":"How should this assignment avoid the error?","help":"precision = tp / (tp + fp)\nZeroDivisionError: division by zero","choices":[{"text":"Use the target unit as denominator","correct":false},{"text":"Return 0 when tp + fp is zero, as specified","correct":true},{"text":"Invent one true positive","correct":false},{"text":"Delete the entire dataset","correct":false}],"fbCorrect":"The published convention handles the no-predicted-warning case.","fbWrong":"THE ANSWER: Return 0 when tp + fp is zero, as specified. The published convention handles the no-predicted-warning case.\n\nWhy the others are wrong. \u201cUse the target unit as denominator\u201d \u2014 Units are not observation counts.  \u201cInvent one true positive\u201d \u2014 That changes the evidence.  \u201cDelete the entire dataset\u201d \u2014 A zero denominator needs a convention, not deletion."},{"n":4,"kind":"interpretation","title":"What is the cost under this rule?","help":"Missed warning costs 5; false alarm costs 1.\nfn = 2; fp = 3","choices":[{"text":"5","correct":false},{"text":"6","correct":false},{"text":"13","correct":true},{"text":"25","correct":false}],"fbCorrect":"5 times 2 plus 3 is 13.","fbWrong":"THE ANSWER: 13. 5 times 2 plus 3 is 13.\n\nWhy the others are wrong. \u201c5\u201d \u2014 This ignores the supplied error counts.  \u201c6\u201d \u2014 Multiplying the two counts is not the stated rule.  \u201c25\u201d \u2014 The costs are not both five."},{"n":5,"kind":"judgement","title":"What can lowering the threshold change?","help":"Probabilities stay fixed; threshold falls from 0.5 to 0.3.","choices":[{"text":"It changes the actual labels","correct":false},{"text":"More observations can be classified as warnings","correct":true},{"text":"It retrains the model automatically","correct":false},{"text":"It guarantees fewer false alarms","correct":false}],"fbCorrect":"The decision rule changes; actual labels are needed to assess its errors.","fbWrong":"THE ANSWER: More observations can be classified as warnings. The decision rule changes; actual labels are needed to assess its errors.\n\nWhy the others are wrong. \u201cIt changes the actual labels\u201d \u2014 The reference outcomes stay fixed.  \u201cIt retrains the model automatically\u201d \u2014 Thresholding does not fit model parameters.  \u201cIt guarantees fewer false alarms\u201d \u2014 Raising more warnings can increase false alarms."}]},{"week":10,"number":9,"title":"CML3113 \u00b7 Weekly Quiz 9 \u2014 Can I trust this model?","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Why keep an equipment ID in only one partition?","help":"The intended deployment is on previously unseen equipment.","choices":[{"text":"To use the target as a group label","correct":false},{"text":"To avoid evaluating on equipment patterns already seen in training","correct":true},{"text":"To delete repeated valid observations","correct":false},{"text":"To make every partition equally large","correct":false}],"fbCorrect":"Repeated observations from one source can make evaluation too optimistic.","fbWrong":"THE ANSWER: To avoid evaluating on equipment patterns already seen in training. Repeated observations from one source can make evaluation too optimistic.\n\nWhy the others are wrong. \u201cTo use the target as a group label\u201d \u2014 Equipment identity, not the answer, defines this split.  \u201cTo delete repeated valid observations\u201d \u2014 Repeated observations can be valid and remain in their group.  \u201cTo make every partition equally large\u201d \u2014 Group separation does not guarantee equal counts."},{"n":2,"kind":"diagnosis","title":"What is wrong with this preparation?","help":"median = all_rows[\"ambient_c\"].median()\n# split into training and validation afterwards","choices":[{"text":"pandas cannot calculate medians","correct":false},{"text":"It uses validation information when learning a fill value","correct":true},{"text":"It guarantees underfitting","correct":false},{"text":"A median is never allowed","correct":false}],"fbCorrect":"Split first and fit preprocessing on training only.","fbWrong":"THE ANSWER: It uses validation information when learning a fill value. Split first and fit preprocessing on training only.\n\nWhy the others are wrong. \u201cpandas cannot calculate medians\u201d \u2014 It can; the problem is which rows it uses.  \u201cIt guarantees underfitting\u201d \u2014 The direct problem is information leakage.  \u201cA median is never allowed\u201d \u2014 Training-only median imputation is allowed when justified."},{"n":3,"kind":"traceback","title":"Why might prediction still fail with missing inputs?","help":"A pipeline contains only a regression model.\nValueError: Input X contains NaN.","choices":[{"text":"The final-test target must be added to X","correct":false},{"text":"All values should become zero","correct":false},{"text":"The warning should be ignored","correct":false},{"text":"The pipeline needs appropriate missing-feature preparation","correct":true}],"fbCorrect":"Include the trained imputer before the model and fit it on training data.","fbWrong":"THE ANSWER: The pipeline needs appropriate missing-feature preparation. Include the trained imputer before the model and fit it on training data.\n\nWhy the others are wrong. \u201cThe final-test target must be added to X\u201d \u2014 That would leak the answer.  \u201cAll values should become zero\u201d \u2014 Zero filling needs a justified policy and may distort data.  \u201cThe warning should be ignored\u201d \u2014 Ignoring an error does not supply usable inputs."},{"n":4,"kind":"interpretation","title":"What does this output show?","help":"Training median = 22.\nValidation values [None, 40] become [22, 40].","choices":[{"text":"The missing measurement was recovered","correct":false},{"text":"Every value was changed","correct":false},{"text":"The training fill was reused on validation","correct":true},{"text":"The validation median was fitted","correct":false}],"fbCorrect":"Validation 40 did not determine a separate fill.","fbWrong":"THE ANSWER: The training fill was reused on validation. Validation 40 did not determine a separate fill.\n\nWhy the others are wrong. \u201cThe missing measurement was recovered\u201d \u2014 It is an estimate.  \u201cEvery value was changed\u201d \u2014 The recorded 40 remains unchanged.  \u201cThe validation median was fitted\u201d \u2014 The given rule uses the training median."},{"n":5,"kind":"judgement","title":"What should be reported for several validation folds?","help":"Errors vary noticeably across folds.","choices":[{"text":"The mean, variation and any important differences between folds","correct":true},{"text":"A claim of guaranteed future performance","correct":false},{"text":"Only the training score","correct":false},{"text":"Only the best fold","correct":false}],"fbCorrect":"The best fold alone hides unstable performance.","fbWrong":"THE ANSWER: The mean, variation and any important differences between folds. The best fold alone hides unstable performance.\n\nWhy the others are wrong. \u201cA claim of guaranteed future performance\u201d \u2014 Finite validation evidence cannot guarantee future errors.  \u201cOnly the training score\u201d \u2014 That does not describe held-out folds.  \u201cOnly the best fold\u201d \u2014 This cherry-picks the evaluation."}]},{"week":11,"number":10,"title":"CML3113 \u00b7 Weekly Quiz 10 \u2014 Features","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which values are produced?","help":"load_pct = 40; ambient_c = 25\nload_fraction = load_pct / 100\ninteraction = load_pct * ambient_c","choices":[{"text":"40 and 65","correct":false},{"text":"0.4 and 1000","correct":true},{"text":"4000 and 1.6","correct":false},{"text":"0.4 and 65","correct":false}],"fbCorrect":"Division converts percent to a fraction; multiplication creates the interaction.","fbWrong":"THE ANSWER: 0.4 and 1000. Division converts percent to a fraction; multiplication creates the interaction.\n\nWhy the others are wrong. \u201c40 and 65\u201d \u2014 The first needs division and the second multiplication.  \u201c4000 and 1.6\u201d \u2014 These use different operations.  \u201c0.4 and 65\u201d \u2014 An interaction here is a product, not a sum."},{"n":2,"kind":"diagnosis","title":"Why is this feature invalid for prediction?","help":"new_feature = future_target / load_pct","choices":[{"text":"It uses the answer that is unavailable at prediction time","correct":true},{"text":"It has a short name","correct":false},{"text":"Ratios are always invalid","correct":false},{"text":"pandas cannot divide columns","correct":false}],"fbCorrect":"A predictor must be obtainable before the target is known.","fbWrong":"THE ANSWER: It uses the answer that is unavailable at prediction time. A predictor must be obtainable before the target is known.\n\nWhy the others are wrong. \u201cIt has a short name\u201d \u2014 Naming is not the leakage issue.  \u201cRatios are always invalid\u201d \u2014 Ratios of available inputs can be useful.  \u201cpandas cannot divide columns\u201d \u2014 It can perform column arithmetic."},{"n":3,"kind":"traceback","title":"What does this error suggest?","help":"valid[\"interaction\"]\nKeyError: 'interaction'","choices":[{"text":"Round the validation data","correct":false},{"text":"The model has too many rows","correct":false},{"text":"The column has not been created under that name in valid","correct":true},{"text":"Fit on validation targets","correct":false}],"fbCorrect":"Apply the same named feature preparation to training and validation.","fbWrong":"THE ANSWER: The column has not been created under that name in valid. Apply the same named feature preparation to training and validation.\n\nWhy the others are wrong. \u201cRound the validation data\u201d \u2014 Rounding does not create the column.  \u201cThe model has too many rows\u201d \u2014 This error concerns a missing key or label.  \u201cFit on validation targets\u201d \u2014 That leaks evaluation answers."},{"n":4,"kind":"interpretation","title":"What is the improvement?","help":"base_mae = 3.0; extended_mae = 2.5\nimprovement = base_mae - extended_mae","choices":[{"text":"A guarantee every prediction improved","correct":false},{"text":"-0.5","correct":false},{"text":"0.5 in the target unit","correct":true},{"text":"0.5 percent in every case","correct":false}],"fbCorrect":"The extended model reduces mean absolute error by 0.5.","fbWrong":"THE ANSWER: 0.5 in the target unit. The extended model reduces mean absolute error by 0.5.\n\nWhy the others are wrong. \u201cA guarantee every prediction improved\u201d \u2014 An average improvement does not guarantee each row improved.  \u201c-0.5\u201d \u2014 That reverses the stated subtraction.  \u201c0.5 percent in every case\u201d \u2014 MAE uses the target unit, not an automatic percentage."},{"n":5,"kind":"judgement","title":"What makes the comparison meaningful?","help":"Compare base features with base features plus an interaction.","choices":[{"text":"Use the same training and validation rows and model protocol","correct":true},{"text":"Use final-test scores to keep trying features","correct":false},{"text":"Choose a different easy validation set","correct":false},{"text":"Always prefer the larger feature set","correct":false}],"fbCorrect":"Changing only the feature set makes the difference interpretable.","fbWrong":"THE ANSWER: Use the same training and validation rows and model protocol. Changing only the feature set makes the difference interpretable.\n\nWhy the others are wrong. \u201cUse final-test scores to keep trying features\u201d \u2014 That turns the final test into selection data.  \u201cChoose a different easy validation set\u201d \u2014 That confounds the comparison.  \u201cAlways prefer the larger feature set\u201d \u2014 More features can fail to improve generalisation."}]},{"week":12,"number":11,"title":"CML3113 \u00b7 Weekly Quiz 11 \u2014 Model comparison (integrative)","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which candidate meets both constraints?","help":"Limits: MAE <= 3 and latency <= 10 ms.\nsimple: MAE 3, latency 2\ncomplex: MAE 1, latency 20","choices":[{"text":"Both","correct":false},{"text":"complex","correct":false},{"text":"Neither","correct":false},{"text":"simple","correct":true}],"fbCorrect":"It satisfies both inclusive limits.","fbWrong":"THE ANSWER: simple. It satisfies both inclusive limits.\n\nWhy the others are wrong. \u201cBoth\u201d \u2014 complex fails the latency limit.  \u201ccomplex\u201d \u2014 Its latency fails the requirement.  \u201cNeither\u201d \u2014 simple meets the limits, including equality on MAE."},{"n":2,"kind":"diagnosis","title":"What is wrong with choosing the lowest error before filtering?","help":"One very accurate candidate exceeds the permitted latency.","choices":[{"text":"Latency and error must be added","correct":false},{"text":"The chosen candidate may be ineligible","correct":true},{"text":"Sorting cannot be used","correct":false},{"text":"All constraints should be dropped","correct":false}],"fbCorrect":"Check every constraint before ranking eligible candidates.","fbWrong":"THE ANSWER: The chosen candidate may be ineligible. Check every constraint before ranking eligible candidates.\n\nWhy the others are wrong. \u201cLatency and error must be added\u201d \u2014 They have different meanings and the policy does not add them.  \u201cSorting cannot be used\u201d \u2014 Sorting is useful after eligibility filtering.  \u201cAll constraints should be dropped\u201d \u2014 That changes the requirements."},{"n":3,"kind":"traceback","title":"What check prevents this error?","help":"winner = eligible.iloc[0][\"name\"]\nIndexError: single positional indexer is out-of-bounds","choices":[{"text":"Check eligible.empty and return None if no rows remain","correct":true},{"text":"Use iloc[1] instead","correct":false},{"text":"Always pick the original first candidate","correct":false},{"text":"Delete the latency column","correct":false}],"fbCorrect":"There is no first row in an empty table.","fbWrong":"THE ANSWER: Check eligible.empty and return None if no rows remain. There is no first row in an empty table.\n\nWhy the others are wrong. \u201cUse iloc[1] instead\u201d \u2014 An empty table has no second row either.  \u201cAlways pick the original first candidate\u201d \u2014 That can choose an ineligible model.  \u201cDelete the latency column\u201d \u2014 Removing evidence does not satisfy the constraints."},{"n":4,"kind":"interpretation","title":"Which name wins the published tie-break?","help":"Both candidates have MAE 2 and latency 3 ms.\nNames: beta, alpha\nSort by error, latency, then name.","choices":[{"text":"alpha","correct":true},{"text":"beta","correct":false},{"text":"Whichever appeared last","correct":false},{"text":"None","correct":false}],"fbCorrect":"With equal numerical criteria, alphabetical name order decides.","fbWrong":"THE ANSWER: alpha. With equal numerical criteria, alphabetical name order decides.\n\nWhy the others are wrong. \u201cbeta\u201d \u2014 That is not the alphabetical first name.  \u201cWhichever appeared last\u201d \u2014 Input order is not the stated tie-break.  \u201cNone\u201d \u2014 Both are eligible and the tie-break resolves the choice."},{"n":5,"kind":"judgement","title":"Which data should guide model selection?","help":"The final test is reserved for the fixed choice.","choices":[{"text":"The nicest-looking training plot","correct":false},{"text":"The largest number of parameters","correct":false},{"text":"Final-test results after every trial","correct":false},{"text":"Validation results under a consistent protocol","correct":true}],"fbCorrect":"The final test should remain independent of repeated choices.","fbWrong":"THE ANSWER: Validation results under a consistent protocol. The final test should remain independent of repeated choices.\n\nWhy the others are wrong. \u201cThe nicest-looking training plot\u201d \u2014 Appearance does not establish held-out performance.  \u201cThe largest number of parameters\u201d \u2014 Complexity alone does not establish quality.  \u201cFinal-test results after every trial\u201d \u2014 Repeated selection on those results uses up the final test."}]},{"week":13,"number":12,"title":"CML3113 \u00b7 Weekly Quiz 12 \u2014 Reproducibility (integrative)","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Why use a relative CSV path?","help":"pd.read_csv(\"data/raw/engineering_data.csv\")","choices":[{"text":"It makes raw data safe to overwrite","correct":false},{"text":"It can work on another computer with the same project structure","correct":true},{"text":"It downloads the file automatically","correct":false},{"text":"It encrypts the data","correct":false}],"fbCorrect":"Document the working folder and include the expected data layout.","fbWrong":"THE ANSWER: It can work on another computer with the same project structure. Document the working folder and include the expected data layout.\n\nWhy the others are wrong. \u201cIt makes raw data safe to overwrite\u201d \u2014 Raw data should still be preserved.  \u201cIt downloads the file automatically\u201d \u2014 A local relative path does not fetch missing files.  \u201cIt encrypts the data\u201d \u2014 Path choice does not provide encryption."},{"n":2,"kind":"diagnosis","title":"What is wrong with trusting a saved output?","help":"A notebook displays a chart but fails after Restart and Run All.","choices":[{"text":"The chart proves the current code works","correct":false},{"text":"Only the chart title matters","correct":false},{"text":"The visible output may come from an earlier session","correct":true},{"text":"Restarting changes the dataset by itself","correct":false}],"fbCorrect":"A fresh run checks whether the saved code and supplied files reproduce it.","fbWrong":"THE ANSWER: The visible output may come from an earlier session. A fresh run checks whether the saved code and supplied files reproduce it.\n\nWhy the others are wrong. \u201cThe chart proves the current code works\u201d \u2014 It may have been saved before the code changed.  \u201cOnly the chart title matters\u201d \u2014 Reproducibility needs executable steps and data.  \u201cRestarting changes the dataset by itself\u201d \u2014 The issue may be missing state or files, not a changed dataset."},{"n":3,"kind":"traceback","title":"What should be checked first?","help":"pd.read_csv(\"data/raw/engineering_data.csv\")\nFileNotFoundError","choices":[{"text":"Change the model hyperparameters","correct":false},{"text":"The working folder, relative path and supplied filename","correct":true},{"text":"Rewrite the analysis using csv.DictReader","correct":false},{"text":"Delete all other files","correct":false}],"fbCorrect":"Confirm the file is present at the path used by the notebook.","fbWrong":"THE ANSWER: The working folder, relative path and supplied filename. Confirm the file is present at the path used by the notebook.\n\nWhy the others are wrong. \u201cChange the model hyperparameters\u201d \u2014 Model settings do not affect file discovery.  \u201cRewrite the analysis using csv.DictReader\u201d \u2014 Changing libraries does not repair a missing file.  \u201cDelete all other files\u201d \u2014 That does not create the required file."},{"n":4,"kind":"interpretation","title":"What does index=False do?","help":"clean.to_csv(\"cleaned_data.csv\", index=False)","choices":[{"text":"It removes the first observation","correct":false},{"text":"It prevents saving","correct":false},{"text":"It omits pandas row labels from the exported CSV columns","correct":true},{"text":"It fills missing values","correct":false}],"fbCorrect":"The data columns remain in the file.","fbWrong":"THE ANSWER: It omits pandas row labels from the exported CSV columns. The data columns remain in the file.\n\nWhy the others are wrong. \u201cIt removes the first observation\u201d \u2014 It controls row labels, not the first data row.  \u201cIt prevents saving\u201d \u2014 to_csv still writes the file.  \u201cIt fills missing values\u201d \u2014 Export options do not perform imputation."},{"n":5,"kind":"judgement","title":"What belongs in a reproducible handover?","help":"Another person must run the work from a fresh session.","choices":[{"text":"Only the final score","correct":false},{"text":"Data paths, dependencies, run order, units and limitations","correct":true},{"text":"Private machine paths with no instructions","correct":false},{"text":"Only screenshots","correct":false}],"fbCorrect":"These explain what is needed and what the results support.","fbWrong":"THE ANSWER: Data paths, dependencies, run order, units and limitations. These explain what is needed and what the results support.\n\nWhy the others are wrong. \u201cOnly the final score\u201d \u2014 A score does not explain data, methods or limitations.  \u201cPrivate machine paths with no instructions\u201d \u2014 Those paths generally fail on another computer.  \u201cOnly screenshots\u201d \u2014 Screenshots cannot reproduce the calculations."}]}]},"CML3111":{"weeks":[{"week":6,"number":6,"title":"CML3111 \u00b7 Weekly Quiz 6 \u2014 Dirty data, and seeing it","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which entry does the missing-value check identify?","help":"s = pd.Series([0, None, 4])\nprint(s.isna().tolist())","choices":[{"text":"No entries","correct":false},{"text":"Only the middle entry","correct":true},{"text":"Every entry","correct":false},{"text":"Zero and the middle entry","correct":false}],"fbCorrect":"Zero is a recorded number. isna recognises the missing middle entry.","fbWrong":"THE ANSWER: Only the middle entry. Zero is a recorded number. isna recognises the missing middle entry.\n\nWhy the others are wrong. \u201cNo entries\u201d \u2014 pandas recognises the missing marker even if the numeric Series stores it as NaN.  \u201cEvery entry\u201d \u2014 The first and last entries are recorded numbers.  \u201cZero and the middle entry\u201d \u2014 Zero is not automatically missing."},{"n":2,"kind":"diagnosis","title":"What is wrong with this duplicate rule?","help":"Rows are separate observations. Equipment E1 has several valid readings.\nclean = df.drop_duplicates(\"equipment_id\")","choices":[{"text":"It fills missing values","correct":false},{"text":"It removes distinct observations from the same equipment","correct":true},{"text":"It keeps every observation","correct":false},{"text":"It sorts by target","correct":false}],"fbCorrect":"Deduplicate observation IDs under the stated policy, not a source ID that can repeat.","fbWrong":"THE ANSWER: It removes distinct observations from the same equipment. Deduplicate observation IDs under the stated policy, not a source ID that can repeat.\n\nWhy the others are wrong. \u201cIt fills missing values\u201d \u2014 drop_duplicates does not fill missing fields.  \u201cIt keeps every observation\u201d \u2014 It retains only the first row per equipment ID.  \u201cIt sorts by target\u201d \u2014 This operation removes rows; it does not sort targets."},{"n":3,"kind":"traceback","title":"Why does this conversion fail?","help":"pd.to_numeric(pd.Series([\"20\", \"24 C\", \"26\"]))\nValueError: Unable to parse string \"24 C\" at position 1","choices":[{"text":"The whole dataset must be deleted","correct":false},{"text":"pandas cannot convert numeric text","correct":false},{"text":"The values must be rounded","correct":false},{"text":"The second value contains a unit suffix","correct":true}],"fbCorrect":"The value and its position identify what needs inspection before repair.","fbWrong":"THE ANSWER: The second value contains a unit suffix. The value and its position identify what needs inspection before repair.\n\nWhy the others are wrong. \u201cThe whole dataset must be deleted\u201d \u2014 Inspect the problematic value; the error does not justify deleting all data.  \u201cpandas cannot convert numeric text\u201d \u2014 It converts strings such as \"20\".  \u201cThe values must be rounded\u201d \u2014 Rounding cannot remove a text unit suffix."},{"n":4,"kind":"interpretation","title":"What does this fill operation do?","help":"s = pd.Series([20, None, 24, 80])\nfilled = s.fillna(s.median())","choices":[{"text":"It fills the gap with zero","correct":false},{"text":"It replaces 80 with 24","correct":false},{"text":"It recovers the true missing measurement","correct":false},{"text":"It inserts 24 for the missing entry and retains 80","correct":true}],"fbCorrect":"The known values are 20, 24 and 80; the median is 24. fillna changes only missing entries.","fbWrong":"THE ANSWER: It inserts 24 for the missing entry and retains 80. The known values are 20, 24 and 80; the median is 24. fillna changes only missing entries.\n\nWhy the others are wrong. \u201cIt fills the gap with zero\u201d \u2014 The supplied fill is the median, not zero.  \u201cIt replaces 80 with 24\u201d \u2014 An extreme recorded value is not a missing value.  \u201cIt recovers the true missing measurement\u201d \u2014 The fill is an estimate, not a recovered observation."},{"n":5,"kind":"judgement","title":"Which output answers the question?","help":"Question: Do mean target values differ by equipment?","choices":[{"text":"A labelled chart of groupby(\"equipment_id\")[\"target\"].mean()","correct":true},{"text":"A chart with no labels","correct":false},{"text":"The total row count alone","correct":false},{"text":"One histogram of all targets","correct":false}],"fbCorrect":"Grouped means compare the requested equipment groups.","fbWrong":"THE ANSWER: A labelled chart of groupby(\"equipment_id\")[\"target\"].mean(). Grouped means compare the requested equipment groups.\n\nWhy the others are wrong. \u201cA chart with no labels\u201d \u2014 Without groups and units, the comparison cannot be interpreted.  \u201cThe total row count alone\u201d \u2014 A count does not compare target means.  \u201cOne histogram of all targets\u201d \u2014 A pooled histogram describes a distribution without comparing group means."}]},{"week":8,"number":7,"title":"CML3111 \u00b7 Weekly Quiz 7 \u2014 Learning from data: the first model","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"What shape does X need here?","help":"features = [\"load_pct\", \"ambient_c\"]\nX = train[features]\ny = train[\"target\"]","choices":[{"text":"Two rows regardless of dataset size","correct":false},{"text":"One row per training observation and two feature columns","correct":true},{"text":"One unrelated row for each target","correct":false},{"text":"A column containing the target only","correct":false}],"fbCorrect":"The two named features form a table; y has a target for each same row.","fbWrong":"THE ANSWER: One row per training observation and two feature columns. The two named features form a table; y has a target for each same row.\n\nWhy the others are wrong. \u201cTwo rows regardless of dataset size\u201d \u2014 Two is the feature count, not the observation count.  \u201cOne unrelated row for each target\u201d \u2014 Features and targets must refer to matching observations.  \u201cA column containing the target only\u201d \u2014 The target is y, not a predictor."},{"n":2,"kind":"diagnosis","title":"Why should prediction use new[features]?","help":"model.fit(train[features], train[\"target\"])","choices":[{"text":"It trains the model again","correct":false},{"text":"It guarantees accurate predictions","correct":false},{"text":"It keeps the same feature names and order as training","correct":true},{"text":"It supplies the new true target","correct":false}],"fbCorrect":"Names and order preserve the meaning of each model input.","fbWrong":"THE ANSWER: It keeps the same feature names and order as training. Names and order preserve the meaning of each model input.\n\nWhy the others are wrong. \u201cIt trains the model again\u201d \u2014 predict uses the fitted model; it does not fit it.  \u201cIt guarantees accurate predictions\u201d \u2014 Consistent inputs are necessary but do not guarantee accuracy.  \u201cIt supplies the new true target\u201d \u2014 Feature inputs must not contain the answer."},{"n":3,"kind":"traceback","title":"What should you check first?","help":"model.fit(X, y)\nValueError: Found input variables with inconsistent numbers of samples","choices":[{"text":"Delete target values at random","correct":false},{"text":"Increase tree depth","correct":false},{"text":"Round all columns","correct":false},{"text":"Whether X and y were selected from the same rows","correct":true}],"fbCorrect":"Separate filtering can leave different observation counts or mismatched rows.","fbWrong":"THE ANSWER: Whether X and y were selected from the same rows. Separate filtering can leave different observation counts or mismatched rows.\n\nWhy the others are wrong. \u201cDelete target values at random\u201d \u2014 This breaks pairing and loses valid data.  \u201cIncrease tree depth\u201d \u2014 Model complexity does not repair mismatched inputs.  \u201cRound all columns\u201d \u2014 Rounding does not change the number of observations."},{"n":4,"kind":"interpretation","title":"What are MAE and RMSE?","help":"actual = [10, 20]\npredicted = [12, 16]","choices":[{"text":"Both are 6","correct":false},{"text":"MAE -1; RMSE 1","correct":false},{"text":"Both are percentages","correct":false},{"text":"MAE 3; RMSE approximately 3.1623","correct":true}],"fbCorrect":"Absolute errors are 2 and 4; squared errors are 4 and 16.","fbWrong":"THE ANSWER: MAE 3; RMSE approximately 3.1623. Absolute errors are 2 and 4; squared errors are 4 and 16.\n\nWhy the others are wrong. \u201cBoth are 6\u201d \u2014 Six is the total absolute error, not its mean.  \u201cMAE -1; RMSE 1\u201d \u2014 MAE uses absolute errors, so signed cancellation is wrong.  \u201cBoth are percentages\u201d \u2014 These errors use the target unit."},{"n":5,"kind":"judgement","title":"Where should the imputer learn its median?","help":"Training, validation and final-test partitions are already separate.","choices":[{"text":"Validation targets","correct":false},{"text":"The combined file","correct":false},{"text":"Training features only","correct":true},{"text":"Each new prediction row independently","correct":false}],"fbCorrect":"The fitted fill must be reused on evaluation data without learning from them.","fbWrong":"THE ANSWER: Training features only. The fitted fill must be reused on evaluation data without learning from them.\n\nWhy the others are wrong. \u201cValidation targets\u201d \u2014 Targets cannot supply predictor fill values.  \u201cThe combined file\u201d \u2014 That uses evaluation information in preprocessing.  \u201cEach new prediction row independently\u201d \u2014 This changes preprocessing at prediction time."}]},{"week":9,"number":8,"title":"CML3111 \u00b7 Weekly Quiz 8 \u2014 Classification","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"How many false negatives are present?","help":"actual    = [1, 1, 0, 0]\npredicted = [1, 0, 1, 0]","choices":[{"text":"4","correct":false},{"text":"0","correct":false},{"text":"2","correct":false},{"text":"1","correct":true}],"fbCorrect":"Only the second row needs a warning but receives none.","fbWrong":"THE ANSWER: 1. Only the second row needs a warning but receives none.\n\nWhy the others are wrong. \u201c4\u201d \u2014 Every row is not an error.  \u201c0\u201d \u2014 The second row is a missed warning.  \u201c2\u201d \u2014 There are two errors, but only one is a false negative."},{"n":2,"kind":"diagnosis","title":"Why is high accuracy insufficient here?","help":"Only 2% of observations need a warning. A model always predicts 0.","choices":[{"text":"It detects all warnings","correct":false},{"text":"It must have perfect recall","correct":false},{"text":"The dataset has no positive observations","correct":false},{"text":"It misses every actual warning","correct":true}],"fbCorrect":"Predicting the majority can give 98% accuracy while recall is zero.","fbWrong":"THE ANSWER: It misses every actual warning. Predicting the majority can give 98% accuracy while recall is zero.\n\nWhy the others are wrong. \u201cIt detects all warnings\u201d \u2014 It predicts no warnings at all.  \u201cIt must have perfect recall\u201d \u2014 Recall counts detected positives, not correct negatives.  \u201cThe dataset has no positive observations\u201d \u2014 Two percent are positives."},{"n":3,"kind":"traceback","title":"How should this assignment avoid the error?","help":"precision = tp / (tp + fp)\nZeroDivisionError: division by zero","choices":[{"text":"Invent one true positive","correct":false},{"text":"Return 0 when tp + fp is zero, as specified","correct":true},{"text":"Delete the entire dataset","correct":false},{"text":"Use the target unit as denominator","correct":false}],"fbCorrect":"The published convention handles the no-predicted-warning case.","fbWrong":"THE ANSWER: Return 0 when tp + fp is zero, as specified. The published convention handles the no-predicted-warning case.\n\nWhy the others are wrong. \u201cInvent one true positive\u201d \u2014 That changes the evidence.  \u201cDelete the entire dataset\u201d \u2014 A zero denominator needs a convention, not deletion.  \u201cUse the target unit as denominator\u201d \u2014 Units are not observation counts."},{"n":4,"kind":"interpretation","title":"What is the cost under this rule?","help":"Missed warning costs 5; false alarm costs 1.\nfn = 2; fp = 3","choices":[{"text":"6","correct":false},{"text":"25","correct":false},{"text":"13","correct":true},{"text":"5","correct":false}],"fbCorrect":"5 times 2 plus 3 is 13.","fbWrong":"THE ANSWER: 13. 5 times 2 plus 3 is 13.\n\nWhy the others are wrong. \u201c6\u201d \u2014 Multiplying the two counts is not the stated rule.  \u201c25\u201d \u2014 The costs are not both five.  \u201c5\u201d \u2014 This ignores the supplied error counts."},{"n":5,"kind":"judgement","title":"What can lowering the threshold change?","help":"Probabilities stay fixed; threshold falls from 0.5 to 0.3.","choices":[{"text":"It changes the actual labels","correct":false},{"text":"More observations can be classified as warnings","correct":true},{"text":"It retrains the model automatically","correct":false},{"text":"It guarantees fewer false alarms","correct":false}],"fbCorrect":"The decision rule changes; actual labels are needed to assess its errors.","fbWrong":"THE ANSWER: More observations can be classified as warnings. The decision rule changes; actual labels are needed to assess its errors.\n\nWhy the others are wrong. \u201cIt changes the actual labels\u201d \u2014 The reference outcomes stay fixed.  \u201cIt retrains the model automatically\u201d \u2014 Thresholding does not fit model parameters.  \u201cIt guarantees fewer false alarms\u201d \u2014 Raising more warnings can increase false alarms."}]},{"week":10,"number":9,"title":"CML3111 \u00b7 Weekly Quiz 9 \u2014 Can I trust this model?","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Why keep an equipment ID in only one partition?","help":"The intended deployment is on previously unseen equipment.","choices":[{"text":"To avoid evaluating on equipment patterns already seen in training","correct":true},{"text":"To delete repeated valid observations","correct":false},{"text":"To make every partition equally large","correct":false},{"text":"To use the target as a group label","correct":false}],"fbCorrect":"Repeated observations from one source can make evaluation too optimistic.","fbWrong":"THE ANSWER: To avoid evaluating on equipment patterns already seen in training. Repeated observations from one source can make evaluation too optimistic.\n\nWhy the others are wrong. \u201cTo delete repeated valid observations\u201d \u2014 Repeated observations can be valid and remain in their group.  \u201cTo make every partition equally large\u201d \u2014 Group separation does not guarantee equal counts.  \u201cTo use the target as a group label\u201d \u2014 Equipment identity, not the answer, defines this split."},{"n":2,"kind":"diagnosis","title":"What is wrong with this preparation?","help":"median = all_rows[\"ambient_c\"].median()\n# split into training and validation afterwards","choices":[{"text":"It uses validation information when learning a fill value","correct":true},{"text":"It guarantees underfitting","correct":false},{"text":"pandas cannot calculate medians","correct":false},{"text":"A median is never allowed","correct":false}],"fbCorrect":"Split first and fit preprocessing on training only.","fbWrong":"THE ANSWER: It uses validation information when learning a fill value. Split first and fit preprocessing on training only.\n\nWhy the others are wrong. \u201cIt guarantees underfitting\u201d \u2014 The direct problem is information leakage.  \u201cpandas cannot calculate medians\u201d \u2014 It can; the problem is which rows it uses.  \u201cA median is never allowed\u201d \u2014 Training-only median imputation is allowed when justified."},{"n":3,"kind":"traceback","title":"Why might prediction still fail with missing inputs?","help":"A pipeline contains only a regression model.\nValueError: Input X contains NaN.","choices":[{"text":"The final-test target must be added to X","correct":false},{"text":"All values should become zero","correct":false},{"text":"The pipeline needs appropriate missing-feature preparation","correct":true},{"text":"The warning should be ignored","correct":false}],"fbCorrect":"Include the trained imputer before the model and fit it on training data.","fbWrong":"THE ANSWER: The pipeline needs appropriate missing-feature preparation. Include the trained imputer before the model and fit it on training data.\n\nWhy the others are wrong. \u201cThe final-test target must be added to X\u201d \u2014 That would leak the answer.  \u201cAll values should become zero\u201d \u2014 Zero filling needs a justified policy and may distort data.  \u201cThe warning should be ignored\u201d \u2014 Ignoring an error does not supply usable inputs."},{"n":4,"kind":"interpretation","title":"What does this output show?","help":"Training median = 22.\nValidation values [None, 40] become [22, 40].","choices":[{"text":"Every value was changed","correct":false},{"text":"The training fill was reused on validation","correct":true},{"text":"The validation median was fitted","correct":false},{"text":"The missing measurement was recovered","correct":false}],"fbCorrect":"Validation 40 did not determine a separate fill.","fbWrong":"THE ANSWER: The training fill was reused on validation. Validation 40 did not determine a separate fill.\n\nWhy the others are wrong. \u201cEvery value was changed\u201d \u2014 The recorded 40 remains unchanged.  \u201cThe validation median was fitted\u201d \u2014 The given rule uses the training median.  \u201cThe missing measurement was recovered\u201d \u2014 It is an estimate."},{"n":5,"kind":"judgement","title":"What should be reported for several validation folds?","help":"Errors vary noticeably across folds.","choices":[{"text":"Only the best fold","correct":false},{"text":"The mean, variation and any important differences between folds","correct":true},{"text":"Only the training score","correct":false},{"text":"A claim of guaranteed future performance","correct":false}],"fbCorrect":"The best fold alone hides unstable performance.","fbWrong":"THE ANSWER: The mean, variation and any important differences between folds. The best fold alone hides unstable performance.\n\nWhy the others are wrong. \u201cOnly the best fold\u201d \u2014 This cherry-picks the evaluation.  \u201cOnly the training score\u201d \u2014 That does not describe held-out folds.  \u201cA claim of guaranteed future performance\u201d \u2014 Finite validation evidence cannot guarantee future errors."}]},{"week":11,"number":10,"title":"CML3111 \u00b7 Weekly Quiz 10 \u2014 Features","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which values are produced?","help":"load_pct = 40; ambient_c = 25\nload_fraction = load_pct / 100\ninteraction = load_pct * ambient_c","choices":[{"text":"0.4 and 1000","correct":true},{"text":"40 and 65","correct":false},{"text":"0.4 and 65","correct":false},{"text":"4000 and 1.6","correct":false}],"fbCorrect":"Division converts percent to a fraction; multiplication creates the interaction.","fbWrong":"THE ANSWER: 0.4 and 1000. Division converts percent to a fraction; multiplication creates the interaction.\n\nWhy the others are wrong. \u201c40 and 65\u201d \u2014 The first needs division and the second multiplication.  \u201c0.4 and 65\u201d \u2014 An interaction here is a product, not a sum.  \u201c4000 and 1.6\u201d \u2014 These use different operations."},{"n":2,"kind":"diagnosis","title":"Why is this feature invalid for prediction?","help":"new_feature = future_target / load_pct","choices":[{"text":"It uses the answer that is unavailable at prediction time","correct":true},{"text":"It has a short name","correct":false},{"text":"Ratios are always invalid","correct":false},{"text":"pandas cannot divide columns","correct":false}],"fbCorrect":"A predictor must be obtainable before the target is known.","fbWrong":"THE ANSWER: It uses the answer that is unavailable at prediction time. A predictor must be obtainable before the target is known.\n\nWhy the others are wrong. \u201cIt has a short name\u201d \u2014 Naming is not the leakage issue.  \u201cRatios are always invalid\u201d \u2014 Ratios of available inputs can be useful.  \u201cpandas cannot divide columns\u201d \u2014 It can perform column arithmetic."},{"n":3,"kind":"traceback","title":"What does this error suggest?","help":"valid[\"interaction\"]\nKeyError: 'interaction'","choices":[{"text":"Round the validation data","correct":false},{"text":"The model has too many rows","correct":false},{"text":"The column has not been created under that name in valid","correct":true},{"text":"Fit on validation targets","correct":false}],"fbCorrect":"Apply the same named feature preparation to training and validation.","fbWrong":"THE ANSWER: The column has not been created under that name in valid. Apply the same named feature preparation to training and validation.\n\nWhy the others are wrong. \u201cRound the validation data\u201d \u2014 Rounding does not create the column.  \u201cThe model has too many rows\u201d \u2014 This error concerns a missing key or label.  \u201cFit on validation targets\u201d \u2014 That leaks evaluation answers."},{"n":4,"kind":"interpretation","title":"What is the improvement?","help":"base_mae = 3.0; extended_mae = 2.5\nimprovement = base_mae - extended_mae","choices":[{"text":"0.5 in the target unit","correct":true},{"text":"0.5 percent in every case","correct":false},{"text":"A guarantee every prediction improved","correct":false},{"text":"-0.5","correct":false}],"fbCorrect":"The extended model reduces mean absolute error by 0.5.","fbWrong":"THE ANSWER: 0.5 in the target unit. The extended model reduces mean absolute error by 0.5.\n\nWhy the others are wrong. \u201c0.5 percent in every case\u201d \u2014 MAE uses the target unit, not an automatic percentage.  \u201cA guarantee every prediction improved\u201d \u2014 An average improvement does not guarantee each row improved.  \u201c-0.5\u201d \u2014 That reverses the stated subtraction."},{"n":5,"kind":"judgement","title":"What makes the comparison meaningful?","help":"Compare base features with base features plus an interaction.","choices":[{"text":"Use the same training and validation rows and model protocol","correct":true},{"text":"Use final-test scores to keep trying features","correct":false},{"text":"Choose a different easy validation set","correct":false},{"text":"Always prefer the larger feature set","correct":false}],"fbCorrect":"Changing only the feature set makes the difference interpretable.","fbWrong":"THE ANSWER: Use the same training and validation rows and model protocol. Changing only the feature set makes the difference interpretable.\n\nWhy the others are wrong. \u201cUse final-test scores to keep trying features\u201d \u2014 That turns the final test into selection data.  \u201cChoose a different easy validation set\u201d \u2014 That confounds the comparison.  \u201cAlways prefer the larger feature set\u201d \u2014 More features can fail to improve generalisation."}]},{"week":12,"number":11,"title":"CML3111 \u00b7 Weekly Quiz 11 \u2014 Model comparison (integrative)","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Which candidate meets both constraints?","help":"Limits: MAE <= 3 and latency <= 10 ms.\nsimple: MAE 3, latency 2\ncomplex: MAE 1, latency 20","choices":[{"text":"Neither","correct":false},{"text":"simple","correct":true},{"text":"Both","correct":false},{"text":"complex","correct":false}],"fbCorrect":"It satisfies both inclusive limits.","fbWrong":"THE ANSWER: simple. It satisfies both inclusive limits.\n\nWhy the others are wrong. \u201cNeither\u201d \u2014 simple meets the limits, including equality on MAE.  \u201cBoth\u201d \u2014 complex fails the latency limit.  \u201ccomplex\u201d \u2014 Its latency fails the requirement."},{"n":2,"kind":"diagnosis","title":"What is wrong with choosing the lowest error before filtering?","help":"One very accurate candidate exceeds the permitted latency.","choices":[{"text":"All constraints should be dropped","correct":false},{"text":"Sorting cannot be used","correct":false},{"text":"Latency and error must be added","correct":false},{"text":"The chosen candidate may be ineligible","correct":true}],"fbCorrect":"Check every constraint before ranking eligible candidates.","fbWrong":"THE ANSWER: The chosen candidate may be ineligible. Check every constraint before ranking eligible candidates.\n\nWhy the others are wrong. \u201cAll constraints should be dropped\u201d \u2014 That changes the requirements.  \u201cSorting cannot be used\u201d \u2014 Sorting is useful after eligibility filtering.  \u201cLatency and error must be added\u201d \u2014 They have different meanings and the policy does not add them."},{"n":3,"kind":"traceback","title":"What check prevents this error?","help":"winner = eligible.iloc[0][\"name\"]\nIndexError: single positional indexer is out-of-bounds","choices":[{"text":"Delete the latency column","correct":false},{"text":"Use iloc[1] instead","correct":false},{"text":"Check eligible.empty and return None if no rows remain","correct":true},{"text":"Always pick the original first candidate","correct":false}],"fbCorrect":"There is no first row in an empty table.","fbWrong":"THE ANSWER: Check eligible.empty and return None if no rows remain. There is no first row in an empty table.\n\nWhy the others are wrong. \u201cDelete the latency column\u201d \u2014 Removing evidence does not satisfy the constraints.  \u201cUse iloc[1] instead\u201d \u2014 An empty table has no second row either.  \u201cAlways pick the original first candidate\u201d \u2014 That can choose an ineligible model."},{"n":4,"kind":"interpretation","title":"Which name wins the published tie-break?","help":"Both candidates have MAE 2 and latency 3 ms.\nNames: beta, alpha\nSort by error, latency, then name.","choices":[{"text":"beta","correct":false},{"text":"Whichever appeared last","correct":false},{"text":"None","correct":false},{"text":"alpha","correct":true}],"fbCorrect":"With equal numerical criteria, alphabetical name order decides.","fbWrong":"THE ANSWER: alpha. With equal numerical criteria, alphabetical name order decides.\n\nWhy the others are wrong. \u201cbeta\u201d \u2014 That is not the alphabetical first name.  \u201cWhichever appeared last\u201d \u2014 Input order is not the stated tie-break.  \u201cNone\u201d \u2014 Both are eligible and the tie-break resolves the choice."},{"n":5,"kind":"judgement","title":"Which data should guide model selection?","help":"The final test is reserved for the fixed choice.","choices":[{"text":"Final-test results after every trial","correct":false},{"text":"Validation results under a consistent protocol","correct":true},{"text":"The largest number of parameters","correct":false},{"text":"The nicest-looking training plot","correct":false}],"fbCorrect":"The final test should remain independent of repeated choices.","fbWrong":"THE ANSWER: Validation results under a consistent protocol. The final test should remain independent of repeated choices.\n\nWhy the others are wrong. \u201cFinal-test results after every trial\u201d \u2014 Repeated selection on those results uses up the final test.  \u201cThe largest number of parameters\u201d \u2014 Complexity alone does not establish quality.  \u201cThe nicest-looking training plot\u201d \u2014 Appearance does not establish held-out performance."}]},{"week":13,"number":12,"title":"CML3111 \u00b7 Weekly Quiz 12 \u2014 Reproducibility (integrative)","intro":"Five questions on the pandas workflow and engineering decisions taught this week. Read each example before choosing one answer.\n\nHOW THIS WORKS\n\u2022 Answer it now, in the 5 minutes on the screen. That is when this is meant to be taken, while the session is still fresh.\n\u2022 The form then stays open for 24 hours and closes itself. That window is there so a dead network or a broken phone does not cost you a mark you had earned. Take it in the room if you can: by Thursday you will have forgotten the session, and the feedback will be worth less to you.\n\u2022 ONE attempt, from your signed-in Google account. You cannot reopen it or change an answer, so read each question once, properly.\n\u2022 The first box asks for your registration number. It is the number printed on your student card, and it is how the mark reaches your record.\n\u2022 Five questions, one mark each, worth 1% of your final mark.\n\u2022 Your best ten of twelve quizzes count. Missing two costs you nothing, and there are no resits.\n\u2022 When you submit, tap View score. You get a tick or a cross on each question with the feedback underneath. Your mark is the number of ticks, and the feedback on anything you got wrong is the part worth reading.\n\u2022 A question left blank scores the same as one answered wrongly, so answer all five.","questions":[{"n":1,"kind":"interpretation","title":"Why use a relative CSV path?","help":"pd.read_csv(\"data/raw/engineering_data.csv\")","choices":[{"text":"It can work on another computer with the same project structure","correct":true},{"text":"It makes raw data safe to overwrite","correct":false},{"text":"It encrypts the data","correct":false},{"text":"It downloads the file automatically","correct":false}],"fbCorrect":"Document the working folder and include the expected data layout.","fbWrong":"THE ANSWER: It can work on another computer with the same project structure. Document the working folder and include the expected data layout.\n\nWhy the others are wrong. \u201cIt makes raw data safe to overwrite\u201d \u2014 Raw data should still be preserved.  \u201cIt encrypts the data\u201d \u2014 Path choice does not provide encryption.  \u201cIt downloads the file automatically\u201d \u2014 A local relative path does not fetch missing files."},{"n":2,"kind":"diagnosis","title":"What is wrong with trusting a saved output?","help":"A notebook displays a chart but fails after Restart and Run All.","choices":[{"text":"Restarting changes the dataset by itself","correct":false},{"text":"The visible output may come from an earlier session","correct":true},{"text":"The chart proves the current code works","correct":false},{"text":"Only the chart title matters","correct":false}],"fbCorrect":"A fresh run checks whether the saved code and supplied files reproduce it.","fbWrong":"THE ANSWER: The visible output may come from an earlier session. A fresh run checks whether the saved code and supplied files reproduce it.\n\nWhy the others are wrong. \u201cRestarting changes the dataset by itself\u201d \u2014 The issue may be missing state or files, not a changed dataset.  \u201cThe chart proves the current code works\u201d \u2014 It may have been saved before the code changed.  \u201cOnly the chart title matters\u201d \u2014 Reproducibility needs executable steps and data."},{"n":3,"kind":"traceback","title":"What should be checked first?","help":"pd.read_csv(\"data/raw/engineering_data.csv\")\nFileNotFoundError","choices":[{"text":"The working folder, relative path and supplied filename","correct":true},{"text":"Change the model hyperparameters","correct":false},{"text":"Rewrite the analysis using csv.DictReader","correct":false},{"text":"Delete all other files","correct":false}],"fbCorrect":"Confirm the file is present at the path used by the notebook.","fbWrong":"THE ANSWER: The working folder, relative path and supplied filename. Confirm the file is present at the path used by the notebook.\n\nWhy the others are wrong. \u201cChange the model hyperparameters\u201d \u2014 Model settings do not affect file discovery.  \u201cRewrite the analysis using csv.DictReader\u201d \u2014 Changing libraries does not repair a missing file.  \u201cDelete all other files\u201d \u2014 That does not create the required file."},{"n":4,"kind":"interpretation","title":"What does index=False do?","help":"clean.to_csv(\"cleaned_data.csv\", index=False)","choices":[{"text":"It removes the first observation","correct":false},{"text":"It fills missing values","correct":false},{"text":"It omits pandas row labels from the exported CSV columns","correct":true},{"text":"It prevents saving","correct":false}],"fbCorrect":"The data columns remain in the file.","fbWrong":"THE ANSWER: It omits pandas row labels from the exported CSV columns. The data columns remain in the file.\n\nWhy the others are wrong. \u201cIt removes the first observation\u201d \u2014 It controls row labels, not the first data row.  \u201cIt fills missing values\u201d \u2014 Export options do not perform imputation.  \u201cIt prevents saving\u201d \u2014 to_csv still writes the file."},{"n":5,"kind":"judgement","title":"What belongs in a reproducible handover?","help":"Another person must run the work from a fresh session.","choices":[{"text":"Only screenshots","correct":false},{"text":"Private machine paths with no instructions","correct":false},{"text":"Data paths, dependencies, run order, units and limitations","correct":true},{"text":"Only the final score","correct":false}],"fbCorrect":"These explain what is needed and what the results support.","fbWrong":"THE ANSWER: Data paths, dependencies, run order, units and limitations. These explain what is needed and what the results support.\n\nWhy the others are wrong. \u201cOnly screenshots\u201d \u2014 Screenshots cannot reproduce the calculations.  \u201cPrivate machine paths with no instructions\u201d \u2014 Those paths generally fail on another computer.  \u201cOnly the final score\u201d \u2014 A score does not explain data, methods or limitations."}]}]}};
function updatePandasQuizzesOctober15(){
 var start=Date.now(),props=PropertiesService.getScriptProperties();
 var state=JSON.parse(props.getProperty('PANDAS_REVISION_20261015')||'{}');
 var links=loadLinks_();
 for(var cohort in PANDAS_QUIZ_DATA){
  var weeks=PANDAS_QUIZ_DATA[cohort].weeks;
  for(var i=0;i<weeks.length;i++){
   var wk=weeks[i],key=cohort+'|'+wk.week;
   if(state[key]==='verified')continue;
   if(Date.now()-start>220000){Logger.log('CONTINUE '+JSON.stringify(state));return;}
   if(!links[key])throw Error('Missing registry '+key);
   var f=FormApp.openById(links[key].formId);
   if(f.isAcceptingResponses()||f.getResponses().length){
    Logger.log('PRESERVED_ACTIVE_OR_ATTEMPTED '+key);continue;
   }
   var items=f.getItems(FormApp.ItemType.MULTIPLE_CHOICE);
   if(items.length!==wk.questions.length)throw Error('Question count mismatch '+key);
   wk.questions.forEach(function(q,j){
    var item=items[j].asMultipleChoiceItem();
    item.setTitle(q.n+'. '+q.title).setHelpText(q.help||'');
    item.setChoices(q.choices.map(function(c){return item.createChoice(c.text,c.correct);}));
    item.setPoints(1).setRequired(true);
    item.setFeedbackForCorrect(FormApp.createFeedback().setText(q.fbCorrect).build());
    item.setFeedbackForIncorrect(FormApp.createFeedback().setText(q.fbWrong).build());
    if(item.getTitle()!==q.n+'. '+q.title||item.getPoints()!==1)throw Error('Verification failed '+key);
    var actual=item.getChoices();
    if(actual.some(function(c,k){return c.getValue()!==q.choices[k].text||c.isCorrectAnswer()!==q.choices[k].correct;}))throw Error('Answer key mismatch '+key);
   });
   f.setDescription(wk.intro);
   state[key]='verified';props.setProperty('PANDAS_REVISION_20261015',JSON.stringify(state));
   Logger.log('VERIFIED '+key+' '+items.length+' questions; accepting='+f.isAcceptingResponses());
  }
 }
 Logger.log('PANDAS_REVISION_COMPLETE '+JSON.stringify(state));
}
