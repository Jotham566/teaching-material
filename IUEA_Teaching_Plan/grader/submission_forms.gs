function configureSubmissionSystem(templateId) {
  if (!templateId) { throw new Error('Pass the upload template form ID.'); }
  var form = FormApp.openById(templateId);
  var uploads = form.getItems().filter(function(i) { return String(i.getType()) === 'FILE_UPLOAD'; });
  if (uploads.length !== 1) { throw new Error('Template needs exactly one file upload item.'); }
  form.setAcceptingResponses(false);
  PropertiesService.getScriptProperties().setProperty(SUBMISSION_TEMPLATE, templateId);
}
function submissionState_() {
  var properties=PropertiesService.getScriptProperties().getProperties(), state={};
  Object.keys(properties).forEach(function(k) {
    if(k.indexOf(SUBMISSION_CONFIG+':')===0) { state[k.slice(SUBMISSION_CONFIG.length+1)]=JSON.parse(properties[k]); }
  });
  return state;
}
function saveSubmissionState_(state,onlyKey) {
  // One property per assessment: a single 52-form JSON exceeds Google's 9 KB value limit.
  var properties={};
  (onlyKey?[onlyKey]:Object.keys(state)).forEach(function(k){properties[SUBMISSION_CONFIG+':'+k]=JSON.stringify(state[k]);});
  PropertiesService.getScriptProperties().setProperties(properties,false);
}
function submissionBook_() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty(SUBMISSION_RESPONSE_BOOK);
  if (id) { return SpreadsheetApp.openById(id); }
  var ss = SpreadsheetApp.create('IUEA and DA assignment submissions');
  props.setProperty(SUBMISSION_RESPONSE_BOOK, ss.getId());
  var sh = ss.getSheets()[0]; sh.setName('Submission audit');
  sh.appendRow(['response_id','assessment_key','student_id','email','submitted_at','deadline','status','file_ids','team_id']);
  return ss;
}
function buildSubmissionForms() {
  var lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    var props = PropertiesService.getScriptProperties();
    var template = props.getProperty(SUBMISSION_TEMPLATE);
    if (!template) { throw new Error('Configure the file-upload template first.'); }
    var state = submissionState_(), start = Date.now();
    var ss = submissionBook_();
    for (var i=0;i<ASSESSMENTS.length;i++) {
      var a = ASSESSMENTS[i];
      if (Date.now()-start > 240000) { break; }
      if (state[a.key] && state[a.key].ready) {
        if(!state[a.key].polished){polishSubmissionForm_(FormApp.openById(state[a.key].formId),a.cohort);state[a.key].polished=true;saveSubmissionState_(state,a.key);}
        continue;
      } // rerun resumes from saved keys
      var form;
      if (state[a.key]) {
        form = FormApp.openById(state[a.key].formId);
      } else {
        var fileName='Course submission v1 '+a.key+' '+a.title;
        var matches=DriveApp.getFilesByName(fileName);
        var copy=matches.hasNext()?matches.next():DriveApp.getFileById(template).makeCopy(fileName);
        if(matches.hasNext()){throw new Error('Multiple pending forms named '+fileName);}
        form=FormApp.openById(copy.getId());
        state[a.key]={formId:form.getId(),ready:false,openAt:a.preserve_existing?null:a.opens_at,closeAt:a.preserve_existing?null:a.closes_at,cursor:0};
        saveSubmissionState_(state);
      }
      form.setAcceptingResponses(false);
      form.setTitle(a.cohort+' '+a.label+' '+a.title);
      form.setDescription('Submit '+a.formats.join(', ')+'. Maximum '+a.maximum+' marks. '+
        'Use your roster student registration number. Latest complete on-time submission is marked. '+
        'Deadline: '+(a.closes_at || 'Not scheduled yet')+' (Kampala UTC+03:00). '+
        'Responses received after the deadline are recorded as LATE, even if the form remains visible.\n\n'+(a.brief||'')+
        '\nUpload accessible text: PDF text must be selectable; PPTX must include narration in speaker notes. Upload reports and slides together in one response.');
      if(!form.collectsEmail()){form.setCollectEmail(true);}
      form.setLimitOneResponsePerUser(false).setAllowResponseEdits(false);
      form.setConfirmationMessage('Submission received. The recorded timestamp determines timeliness. This receipt is not a grade.');
      configureSubmissionIdentity_(submissionTextItem_(form,'student_id',false),a.cohort);
      submissionTextItem_(form,'team_id',false).setHelpText('For team work, use the registered team ID. Otherwise leave blank.');
      submissionTextItem_(form,'repository_url',false).setRequired(a.id==='W02')
        .setHelpText('Repository URL for code-based assignments. Keep personal identifiers out of public files.');
      submissionTextItem_(form,'submission_notes',true).setHelpText('State the file to mark and any declared assistance.');
      polishSubmissionForm_(form,a.cohort);
      if(submissionDestinationId_(form)!==ss.getId()){form.setDestination(FormApp.DestinationType.SPREADSHEET,ss.getId());}
      if(typeof form.supportsAdvancedResponderPermissions==='function'&&form.supportsAdvancedResponderPermissions()){form.setPublished(true);}
      form.setAcceptingResponses(false);
      state[a.key].url = form.getPublishedUrl(); state[a.key].ready = true;state[a.key].polished=true;
      saveSubmissionState_(state);
    }
    ensureSubmissionTrigger_();
    logSubmissionState_(state);
  } finally { lock.releaseLock(); }
}
function submissionDestinationId_(form) {
  try { return form.getDestinationId(); }
  catch(e) {
    if(String(e).indexOf('no response destination')>=0){return null;}
    throw e;
  }
}
function submissionFieldKey_(title) {
  var key=String(title).trim().toLowerCase().replace(/\s+/g,'_');
  return key==='student_registration_number'?'student_id':key;
}
function configureSubmissionIdentity_(item,cohort) {
  item.setRequired(true).setHelpText(cohort==='DA'?'Use your roster ID.':'Enter your own Student Registration Number exactly as shown on your university record. This field is required; any registration-number format is accepted.');
  if(cohort==='DA') { item.setValidation(FormApp.createTextValidation().requireTextMatchesPattern('^S[0-9]{4,8}$').build()); }
  else { item.clearValidation(); }
  return item;
}
function polishSubmissionForm_(form,cohort) {
  var labels={student_id:cohort==='DA'?'Student ID':'Student Registration Number',team_id:'Team ID',repository_url:'Repository URL',submission_notes:'Submission notes'};
  var items=form.getItems(), upload;
  items.forEach(function(item){
    var key=submissionFieldKey_(item.getTitle());
    if(labels[key]){item.setTitle(labels[key]);}
    if(String(item.getType())==='FILE_UPLOAD'){upload=item;item.setTitle('Upload your assessment files');}
  });
  if(upload&&upload.getIndex()!==items.length-1){form.moveItem(upload.getIndex(),items.length-1);}
}
function submissionTextItem_(form,title,paragraph) {
  var matches=form.getItems().filter(function(i){return submissionFieldKey_(i.getTitle())===title;});
  if(matches.length>1){throw new Error('Duplicate field '+title);}
  if(matches.length){return paragraph?matches[0].asParagraphTextItem():matches[0].asTextItem();}
  return (paragraph?form.addParagraphTextItem():form.addTextItem()).setTitle(title);
}
function ensureSubmissionTrigger_() {
  var exists = ScriptApp.getProjectTriggers().some(function(t) { return t.getHandlerFunction()==='syncSubmissions'; });
  if (!exists) { ScriptApp.newTrigger('syncSubmissions').timeBased().everyMinutes(5).create(); }
}
function setSubmissionWindow(key, opensAt, closesAt) {
  var start=Date.parse(opensAt), end=Date.parse(closesAt);
  if (!isFinite(start)||!isFinite(end)||end<=start) { throw new Error('Use ISO timestamps with timezone, close after open.'); }
  if (!/[+-]\d\d:\d\d$|Z$/.test(opensAt)||!/[+-]\d\d:\d\d$|Z$/.test(closesAt)) { throw new Error('Timezone required.'); }
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    var state=submissionState_(); if (!state[key]) { throw new Error('Unknown assessment'); }
    state[key].openAt=opensAt; state[key].closeAt=closesAt;state[key].closedScanned=false;saveSubmissionState_(state,key);
    var form=FormApp.openById(state[key].formId);
    form.setDescription(form.getDescription().replace(/Deadline: .*? \(Kampala UTC\+03:00\)/,'Deadline: '+Utilities.formatDate(new Date(closesAt),'Africa/Kampala','yyyy-MM-dd HH:mm')+' (Kampala UTC+03:00)'));
    var audit=submissionBook_().getSheetByName('Submission audit'),rows=audit.getDataRange().getValues();
    rows.slice(1).forEach(function(r,i){if(r[1]===key){
      audit.getRange(i+2,6,1,2).setValues([[closesAt,submissionStatus_(r[4],opensAt,closesAt)]]);
    }});
  } finally {lock.releaseLock();}
  syncSubmissions();
}
function submissionStatus_(timestamp, openAt, closeAt) {
  var at=Date.parse(timestamp), begin=Date.parse(openAt), end=Date.parse(closeAt);
  if (!isFinite(at)||!isFinite(begin)||!isFinite(end)) { return 'UNSCHEDULED'; }
  return at<begin ? 'EARLY' : at>end ? 'LATE' : 'ON_TIME';
}
function syncSubmissions() {
  var lock=LockService.getScriptLock(); if (!lock.tryLock(1000)) { return; }
  try {
    var state=submissionState_(), now=Date.now(), started=now;
    var audit=submissionBook_().getSheetByName('Submission audit');
    var values=audit.getDataRange().getValues(), seen={};
    values.slice(1).forEach(function(r) { seen[r[0]]=true; });
    var keys=Object.keys(state).sort();
    var props=PropertiesService.getScriptProperties();
    var offset=Number(props.getProperty(SUBMISSION_CONFIG+'_SCAN_OFFSET')||0)%Math.max(1,keys.length);
    for (var n=0;n<keys.length;n++) {
      var pos=(offset+n)%keys.length, key=keys[pos], a=state[key];
      if (Date.now()-started>240000) { props.setProperty(SUBMISSION_CONFIG+'_SCAN_OFFSET',String(pos)); break; }
      if (!a.ready) { continue; }
      var begin=Date.parse(a.openAt), end=Date.parse(a.closeAt);
      // New forms are closed. Scan only scheduled windows and one final closure
      // pass, avoiding 52 Forms API scans every five minutes for the semester.
      if(!isFinite(begin)||!isFinite(end)||now<begin||a.closedScanned){continue;}
      try {
        var form=FormApp.openById(a.formId);
        var accepting=(submissionAssessmentReleased_(key,a)||submissionCatchupCollectionAllowed_(key,a))&&a.uploadReady===true&&isFinite(begin)&&isFinite(end)&&now>=begin&&now<=end;
        if (form.isAcceptingResponses()!==accepting) { form.setAcceptingResponses(accepting); }
        var responses=a.cursor ? form.getResponses(new Date(a.cursor-1000)) : form.getResponses();
        responses.forEach(function(r) {
          if (seen[r.getId()]) { return; }
          var sid='',files=[],team='';
          r.getItemResponses().forEach(function(ir) {
            if(submissionFieldKey_(ir.getItem().getTitle())==='student_id') { sid=String(ir.getResponse()).trim().toUpperCase(); }
            if(submissionFieldKey_(ir.getItem().getTitle())==='team_id') { team=String(ir.getResponse()).trim(); }
            if(String(ir.getItem().getType())==='FILE_UPLOAD') { files=files.concat(ir.getResponse()); }
          });
          var stamp=r.getTimestamp().toISOString();
          audit.appendRow([r.getId(),key,sheetText_(sid),r.getRespondentEmail(),stamp,a.closeAt,
            submissionStatus_(stamp,a.openAt,a.closeAt),JSON.stringify(files),sheetText_(team)]);
          seen[r.getId()]=true;
          a.cursor=Math.max(a.cursor||0,r.getTimestamp().getTime());
        });
        a.lastSuccess=new Date().toISOString(); delete a.error;
        if(now>end){a.closedScanned=true;}
      } catch(e) { a.error=String(e); /* Keep entry for automatic retry. */ }
      saveSubmissionState_(state,key);
    }
  } finally { lock.releaseLock(); }
}
function submissionStatus() { logSubmissionState_(submissionState_()); }
function sheetText_(value){return /^[=+@-]/.test(String(value))?"'"+value:value;}

/** Creates a private export folder with original Drive IDs as filenames.
 * Download this folder from Drive, extract it locally, then prepare_submissions.py.
 * Rerunning resumes; uploaded originals are never renamed or deleted.
 */
function exportSubmissionFiles(key) {
  if(!submissionState_()[key]) { throw new Error('Unknown assessment key'); }
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    var props=PropertiesService.getScriptProperties(),property='UPLOAD_EXPORT:'+key;
    var id=props.getProperty(property),folder;
    if(id){folder=DriveApp.getFolderById(id);}else{
      folder=DriveApp.createFolder('Private submission export '+key.replace('|',' '));
      props.setProperty(property,folder.getId());
    }
    var sheet=submissionBook_().getSheetByName('Submission audit'),rows=sheet.getDataRange().getValues();
    var files={},existing=folder.getFiles(),start=Date.now();
    while(existing.hasNext()){files[existing.next().getName()]=true;}
    for(var i=1;i<rows.length;i++) {
      var row=rows[i];if(row[1]!==key||row[6]!=='ON_TIME'){continue;}
      var ids=JSON.parse(row[7]);
      for(var j=0;j<ids.length;j++) {
        if(Date.now()-start>240000){Logger.log('Export paused; rerun exportSubmissionFiles with the same key. '+folder.getUrl());return;}
        var source=DriveApp.getFileById(ids[j]);
        var ext=source.getName().match(/\.[A-Za-z0-9]+$/);
        if(!ext){throw new Error('Uploaded file has no extension: '+ids[j]);}
        var name=ids[j]+ext[0].toLowerCase();
        if(!files[name]){source.makeCopy(name,folder);files[name]=true;}
      }
    }
    var csv=rows.filter(function(r,i){return i===0||r[1]===key;}).map(function(r){
      return r.map(function(v){return '"'+String(v===null?'':v).replace(/"/g,'""')+'"';}).join(',');
    }).join('\r\n');
    var audits=folder.getFilesByName('submission_audit.csv');
    if(audits.hasNext()){audits.next().setContent(csv);}else{folder.createFile('submission_audit.csv',csv,MimeType.CSV);}
    Logger.log('Export complete: '+folder.getUrl());
  } finally {lock.releaseLock();}
}

/** Confirm only after the Forms UI has verified upload folders AND verified-email collection. */
function confirmSubmissionReadiness(keys) {
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    var state=submissionState_();
    keys.forEach(function(k){if(!state[k]||!state[k].ready){throw new Error('Unconfigured form '+k);}});
    keys.forEach(function(k){state[k].uploadReady=true;state[k].uploadVerifiedAt=new Date().toISOString();saveSubmissionState_(state,k);});
  } finally {lock.releaseLock();}
  syncSubmissions();
}
function finalizeSubmissionSetup() {
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    var state=submissionState_(), ss=submissionBook_();
    var sheet=ss.getSheetByName('Assignment links')||ss.insertSheet('Assignment links');
    var rows=[['Cohort / track','Assignment','Title','Opens (Kampala UTC+03)','Closes (Kampala UTC+03)','Responder link','Upload verification']];
    ASSESSMENTS.forEach(function(a){
      var r=state[a.key];if(!r||!r.ready){return;}
      var form=FormApp.openById(r.formId);
      var message=r.openAt&&r.closeAt ? 'Submission window: '+Utilities.formatDate(new Date(r.openAt),'Africa/Kampala','EEE d MMM yyyy, HH:mm')+' to '+Utilities.formatDate(new Date(r.closeAt),'Africa/Kampala','EEE d MMM yyyy, HH:mm')+' (Kampala). Upload during this window and keep a local copy.' : 'This assignment is not open. Follow your lecturer\'s published submission instructions and keep a local copy of your work.';
      try { form.setCustomClosedFormMessage(message); }
      catch(e) { Logger.log('Closed-message update failed for '+a.key+': '+e); }
      rows.push([a.cohort,a.label,a.title,r.openAt||'Not scheduled',r.closeAt||'Not scheduled',r.url,r.uploadReady?'Verified':'Pending UI verification']);
    });
    sheet.clearContents();sheet.getRange(1,1,rows.length,7).setValues(rows).setWrap(true);
    sheet.setFrozenRows(1);sheet.getRange(1,1,1,7).setFontWeight('bold').setBackground('#dce6f1');
    sheet.setColumnWidths(1,2,120);sheet.setColumnWidth(3,230);sheet.setColumnWidths(4,2,190);sheet.setColumnWidth(6,350);sheet.setColumnWidth(7,170);
    Logger.log('Assignment links and audit: '+ss.getUrl());
    Logger.log('Configured forms: '+(rows.length-1)+'; upload verified: '+Object.keys(state).filter(function(k){return state[k].uploadReady;}).length);
  } finally {lock.releaseLock();}
}

function logSubmissionState_(state) {
  Object.keys(state).sort().forEach(function(key){Logger.log('FORM '+JSON.stringify(Object.assign({key:key},state[key])));});
  Logger.log('FORMS '+Object.keys(state).length+' configured');
}

/** Upload verification does not establish assessment/grader readiness. */
function submissionAssessmentReleased_(key, state) {
  if(state.assessmentReleased===false){return false;}
  if(state.assessmentReleased===true){return typeof state.releaseEvidence==='string'&&state.releaseEvidence.trim().length>=20;}
  return /^(CML3111|CML3112|CML3113)\|W0[2-5]$/.test(key)||key==='DA|S05';
}
/** Explicit Week 1 catch-up collection does not validate or release grading. */
function submissionCatchupCollectionAllowed_(key,state){
  return /^(CML3111|CML3112|CML3113)\|W01$/.test(key)&&state.collectionOnly===true&&
    typeof state.collectionEvidence==='string'&&state.collectionEvidence.trim().length>=20;
}
/** Call only after the issued tasks and current grading calibration are validated. */
function setAssessmentRelease(key,released,evidenceReference) {
  if(typeof released!=='boolean'||typeof evidenceReference!=='string'||evidenceReference.trim().length<20){throw Error('Supply a release decision and a meaningful validation/evidence reference.');}
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    var state=submissionState_();
    if(!state[key]||!ASSESSMENTS.some(function(a){return a.key===key;})){throw Error('Unknown assessment '+key);}
    state[key].assessmentReleased=released;state[key].releaseEvidence=evidenceReference.trim();state[key].releaseDecisionAt=new Date().toISOString();
    saveSubmissionState_(state,key);
    if(!released){FormApp.openById(state[key].formId).setAcceptingResponses(false);}
  } finally {lock.releaseLock();}
  syncSubmissions();
}
function auditAssessmentReleaseGate() {
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    var state=submissionState_(),rows=[['Assessment','Release status','Evidence / required action','Accepting responses']],held=0;
    ASSESSMENTS.forEach(function(a){
      var r=state[a.key];if(!r||!r.ready){throw Error('Unconfigured assessment '+a.key);}
      var graded=submissionAssessmentReleased_(a.key,r),collection=submissionCatchupCollectionAllowed_(a.key,r);
      var allowed=graded||collection,f=FormApp.openById(r.formId);
      if(!allowed&&f.isAcceptingResponses()){f.setAcceptingResponses(false);}
      var accepting=f.isAcceptingResponses();if(!allowed&&accepting){throw Error('Draft form did not close '+a.key);}
      if(!allowed){held++;}
      rows.push([a.key,graded?'RELEASED':collection?'COLLECTION ONLY — GRADING HELD':'HELD',(collection?r.collectionEvidence:r.releaseEvidence)||(allowed?'W02 calibration v10; W03-W05/S05 deterministic regression checks.':'Complete issued-task checks and current local grading calibration before release.'),accepting]);
    });
    var book=submissionBook_(),sheet=book.getSheetByName('Assessment release')||book.insertSheet('Assessment release');
    sheet.clearContents();sheet.getRange(1,1,rows.length,4).setValues(rows).setWrap(true);sheet.setFrozenRows(1);
    sheet.getRange(1,1,1,4).setFontWeight('bold');sheet.setColumnWidths(1,2,160);sheet.setColumnWidth(3,550);sheet.setColumnWidth(4,150);
    Logger.log('ASSESSMENT_RELEASE_GATE_PASS: '+(rows.length-1)+' checked; '+held+' held closed. Schedules, responses and marks preserved.');
  } finally {lock.releaseLock();}
}
