ML_PROJECT_NOTEBOOKS["CML3113|ML_REHEARSAL"] = "{\"cells\": [{\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"# CML3113 Engineering ML project: REHEARSAL (unmarked), the same tasks as the project\\n\", \"Run **Setup: run me first**, then do each task in order and store the results it names. The split uses random_state=29 here, so the numbers differ from the project's. Practise with a 3-hour timer.\\n\", \"There is no Submit button: your notebook saves itself; on the entry page use Check my work and I have finished. Nothing is locked or marked.\\n\", \"No AI tools and no help from other people, as in the project.\\n\", \"Add as many cells as you like under a task; plain code is fine (no functions needed).\"]}, {\"cell_type\": \"code\", \"metadata\": {\"tags\": [\"iuea-support\"], \"cellView\": \"form\"}, \"source\": \"#@title Setup: run me first\\n# IUEA-SETUP-CELL (supplied). Run it first, and again after a restart. The marking computer always uses the original of this cell.\\n_IUEA_IDENTITY = {\\\"course\\\": \\\"CML3113\\\", \\\"test\\\": \\\"ML_REHEARSAL\\\"}\\nimport base64, bz2, hashlib, io, json, os\\nimport numpy as np\\nimport pandas as pd\\nimport matplotlib.pyplot as plt\\nfrom sklearn.pipeline import make_pipeline\\nfrom sklearn.impute import SimpleImputer\\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\\nfrom sklearn.compose import make_column_transformer\\nfrom sklearn.dummy import DummyRegressor\\nfrom sklearn.linear_model import LinearRegression, LogisticRegression\\nfrom sklearn.tree import DecisionTreeRegressor\\nfrom sklearn.metrics import confusion_matrix, precision_score, recall_score\\nFULL_NAME = _IUEA_IDENTITY.get(\\\"name\\\", \\\"\\\")\\nSTUDENT_ID = _IUEA_IDENTITY.get(\\\"registration\\\", \\\"\\\")\\nCOHORT = _IUEA_IDENTITY.get(\\\"course\\\", \\\"\\\")\\nTEST_ID = _IUEA_IDENTITY.get(\\\"test\\\", \\\"\\\")\\n_IUEA_ALLOCATION = _IUEA_IDENTITY.get(\\\"allocation\\\", \\\"\\\")\\n_IUEA_DEADLINE = _IUEA_IDENTIT