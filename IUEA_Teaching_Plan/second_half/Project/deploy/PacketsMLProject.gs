A_DEADLINE = _IUEA_IDENTITY.get(\\\"deadline\\\", \\\"\\\")\\n_PACKED = '''\\n__IUEA_PACKED_DATA__\\n'''\\n_bytes = bz2.decompress(base64.b64decode(\\\"\\\".join(_PACKED.split())))\\nif hashlib.sha256(_bytes).hexdigest() != 'ba456d87fe10dc6963479378c73443df7f1d0b8384578228e3124881a5aca622':\\n    raise RuntimeError(\\\"The data in this cell is damaged. Tell your lecturer.\\\")\\n_data = json.loads(_bytes)\\n# Houses: Ames, Iowa sales 2006 to 2010 (De Cock 2011). Machines: AI4I 2020, SYNTHETIC data modelled on real maintenance data (Matzka 2020).\\nH_KEEP = ['Order', 'MS SubClass', 'Lot Frontage', 'Lot Area', 'Overall Qual', 'Overall Cond', 'Year Built', 'Year Remod/Add', 'Mas Vnr Area', 'BsmtFin SF 1', 'BsmtFin SF 2', 'Bsmt Unf SF', 'Total Bsmt SF', '1st Flr SF', '2nd Flr SF', 'Low Qual Fin SF', 'Gr Liv Area', 'Bsmt Full Bath', 'Bsmt Half Bath', 'Full Bath', 'Half Bath', 'Bedroom AbvGr', 'Kitchen AbvGr', 'TotRms AbvGrd', 'Fireplaces', 'Garage Yr Blt', 'Garage Cars', 'Garage Area', 'Wood Deck SF', 'Open Porch SF', 'Enclosed Porch', '3Ssn Porch', 'Screen Porch', 'Pool Area', 'Misc Val', 'Mo Sold', 'Yr Sold', 'MS Zoning', 'Street', 'Alley', 'Lot Shape', 'Land Contour', 'Utilities', 'Lot Config', 'Land Slope', 'Neighborhood', 'Condition 1', 'Condition 2', 'Bldg Type', 'House Style', 'Roof Style', 'Roof Matl', 'Exterior 1st', 'Exterior 2nd', 'Mas Vnr Type', 'Exter Qual', 'Exter Cond', 'Foundation', 'Bsmt Qual', 'Bsmt Cond', 'Bsmt Exposure', 'BsmtFin Type 1', 'BsmtFin Type 2', 'Heating', 'Heating QC', 'Central Air', 'Electrical', 'Kitchen Qual', 'Functional', 'Fireplace Qu', 'Garage Type', 'Garage Finish', 'Garage Qual', 'Garage Cond', 'Paved Drive', 'Pool QC', 'Fence', 'Misc Feature', 'Sale Type', 'Sale Condition', 'SalePrice']\\nM_KEEP = ['Type', 'Air temperature [K]', 'Process temperature [K]', 'Rotational speed [rpm]', 'Torque [Nm]', 'Tool wear [min]', 'Machine failure']\\nH_TARGET, H_UNIT = 'SalePrice', 'USD'\\nH_FEATURES = ['MS SubClass', 'Lot Frontage', 'Lot Area', 'Overall Qual', 'Overall Cond', 'Year Built', 'Year Remod/Add', 'Mas Vnr Area', 'BsmtFin SF 1', 'BsmtFin SF 2', 'Bsmt Unf SF', 'Total Bsmt SF', '1st Flr SF', '2nd Flr SF', 'Low Qual Fin SF', 'Gr Liv Area', 'Bsmt Full Bath', 'Bsmt Half Bath', 'Full Bath', 'Half Bath', 'Bedroom AbvGr', 'Kitchen AbvGr', 'TotRms AbvGrd', 'Fireplaces', 'Garage Yr Blt', 'Garage Cars', 'Garage Area', 'Wood Deck SF', 'Open Porch SF', 'Enclosed Porch', '3Ssn Porch', 'Screen Porch', 'Pool Area', 'Misc Val', 'Mo Sold', 'Yr Sold']\\nTEXT_FEATURES = ['MS Zoning', 'Street', 'Alley', 'Lot Shape', 'Land Contour', 'Utilities', 'Lot Config', 'Land Slope', 'Neighborhood', 'Condition 1', 'Condition 2', 'Bldg Type', 'House Style', 'Roof Style', 'Roof Matl', 'Exterior 1st', 'Exterior 2nd', 'Mas Vnr Type', 'Exter Qual', 'Exter Cond', 'Foundation', 'Bsmt Qual', 'Bsmt Cond', 'Bsmt Exposure', 'BsmtFin Type 1', 'BsmtFin Type 2', 'Heating', 'Heating QC', 'Central Air', 'Electrical', 'Kitchen Qual', 'Functional', 'Fireplace Qu', 'Garage Type', 'Garage Finish', 'Garage Qual', 'Garage Cond', 'Paved Drive', 'Pool QC', 'Fence', 'Misc Feature', 'Sale Type', 'Sale Condition']\\nM_TARGET, M_LIMIT = 'Machine failure', 1\\nM_FEATURES = ['Air temperature [K]', 'Process temperature [K]', 'Rotational speed [rpm]', 'Torque [Nm]', 'Tool wear [min]', 'Type']\\nTHRESHOLD = 0.5\\nMAX_MAE, MAX_MS = 25000, 50   # the client's limits: teaching numbers, not real ones\\nLATENCY_MS = {'baseline': 1, 'linear': 3, 'tree': 30}\\nhouses_raw = pd.read_csv(io.StringIO(_data[\\\"houses\\\"]), sep=\\\"\\\\t\\\")\\nmachines_raw = pd.read_csv(io.StringIO(_data[\\\"machines\\\"]))\\n_HOUSE_TEST = pd.read_csv(io.StringIO(_data[\\\"house_test\\\"]))\\n_MACHINE_TEST = pd.read_csv(io.StringIO(_data[\\\"machine_test\\\"]))\\ndef choose_model(maes):\\n    ok = [m for m in maes if maes[m] is not None and maes[m] <= MAX_MAE and LATENCY_MS[m] <= MAX_MS]\\n    return min(ok, key=lambda m: (maes[m], LATENCY_MS[m], m)) if ok else None\\nTEST_OPEN_LOG = []\\ndef open_test_set(model_name):\\n    if model_name not in (\\\"baseline\\\", \\\"linear\\\", \\\"tree\\\"):\\n        raise ValueError('use \\\"baseline\\\", \\\"linear\\\" or \\\"tree\\\"')\\n    if TEST_OPEN_LOG or os.path.exists(\\\"test_opened.json\\\"):\\n        print(\\\"WARNING: THE TEST SET WAS ALREADY OPENED. Opening it again means it is no longer an honest test.\\\")\\n    json.dump({\\\"model\\\": model_name}, open(\\\"test_opened.json\\\", \\\"w\\\"))\\n    TEST_OPEN_LOG.append([model_name, THRESHOLD])\\n    return _HOUSE_TEST.copy(), _MACHINE_TEST.copy()\\nprint(\\\"houses_raw:\\\", houses_raw.shape, \\\"| machines_raw:\\\", machines_raw.shape, \\\"| H_TARGET:\\\", H_TARGET, \\\"| M_TARGET:\\\", M_TARGET)\\n\\n# Automatic backup (supplied). Inside Colab, a copy of the notebook on your screen goes to your lecturer every 5 minutes.\\n# You do not need to do anything. Your work is collected automatically at your deadline.\\ndef _iuea_backup_start(address='https://iuea-test-entry.jothammartin-wambi.workers.dev/api/backup', minutes=5):\\n    import json, threading, time, urllib.request\\n    try:\\n        from IPython import get_ipython\\n        shell = get_ipython()\\n        if shell is None or \\\"google.colab\\\" not in type(shell).__module__:\\n            return                                   # not in Colab (the marking computer, Check my notebook): no backup\\n        from google.colab import _message, output\\n        from IPython.display import display, HTML\\n    except Exception:\\n        return\\n    attempt = str(globals().get(\\\"_IUEA_ALLOCATION\\\", \\\"\\\"))\\n    if not attempt:\\n        print(\\\"Backup is off: run the first cell (your details and the countdown) first, then this cell again.\\\")\\n        return\\n    old = globals().get(\\\"_iuea_backup_thread\\\")\\n    if old is not None and old.is_alive():\\n        return\\n    note = display(HTML(\\\"\\\"), display_id=True)\\n    packed = _PACKED.strip()\\n    def send():\\n        notebook = _message.blocking_request(\\\"get_ipynb\\\", timeout_sec=60)[\\\"ipynb\\\"]\\n        for cell in notebook.get(\\\"cells\\\", []):\\n            text = \\\"\\\".join(cell.get(\\\"source\\\", \\\"\\\")) if isinstance(cell.get(\\\"source\\\"), list) else str(cell.get(\\\"source\\\", \\\"\\\"))\\n            if \\\"# IUEA-SETUP-CELL\\\" in text:\\n                cell[\\\"source\\\"] = text.replace(packed, \\\"__IUEA_\\\" + \\\"PACKED_DATA__\\\")\\n        href = str(output.eval_js(\\\"location.href\\\"))[:500]\\n        body = json.dumps({\\\"attempt\\\": attempt, \\\"href\\\": href, \\\"notebook\\\": json.dumps(notebook)}).encode(\\\"utf-8\\\")\\n        request = urllib.request.Request(address, data=body, headers={\\\"Content-Type\\\": \\\"application/json\\\"}, method=\\\"POST\\\")\\n        with urllib.request.urlopen(request, timeout=60) as reply:\\n            return json.loads(reply.read().decode(\\\"utf-8\\\"))\\n    def loop():\\n        while True:\\n            try:\\n                answer = send() or {}\\n                result = answer.get(\\\"result\\\") or {}\\n                if result.get(\\\"other_file\\\"):\\n                    note.update(HTML('<div style=\\\"border:3px solid #b3261e;background:#fff0ee;padding:10px;font-size:16px;color:#7a1712\\\">'\\n                                     '<b>You are working in a different file from your issued notebook.</b> Your work here is still backed up. '\\n                                     'Go back to the entry page and click Resume, or keep working here and tell your lecturer on the class channel.</div>'))\\n                elif answer.get(\\\"ok\\\"):\\n                    note.update(HTML('<div style=\\\"color:#526577;font-size:13px\\\">Automatic backup sent at ' + time.strftime(\\\"%H:%M\\\") + '. Your notebook also saves itself; press Ctrl+S now and then.</div>'))\\n                elif result.get(\\\"closed\\\") or \\\"deadline\\\" in str(answer.get(\\\"error\\\", \\\"\\\")):\\n                    note.update(HTML('<div style=\\\"color:#526577;font-size:13px\\\">Your time has ended. Your work was collected at your deadline.</div>'))\\n                    return\\n            except Exception:\\n                pass\\n            time.sleep(minutes * 60)\\n    thread = threading.Thread(target=loop, name=\\\"iuea-backup\\\", daemon=True)\\n    thread.start()\\n    globals()[\\\"_iuea_backup_thread\\\"] = thread\\n_iuea_backup_start()\\n\\ndef _iuea_countdown_start():\\n    import datetime\\n    try:\\n        from IPython import get_ipython\\n        shell = get_ipython()\\n        if shell is None or \\\"google.colab\\\" not in type(shell).__module__ or not _IUEA_DEADLINE:\\n            return\\n    except Exception:\\n        return\\n    end = datetime.datetime.fromisoformat(_IUEA_DEADLINE.replace(\\\"Z\\\", \\\"+00:00\\\"))\\n    local = (end + datetime.timedelta(hours=3)).strftime(\\\"%H:%M\\\")\\n    practice = TEST_ID == \\\"ML_REHEARSAL\\\"\\n    def line(*_):\\n        left = (end - datetime.datetime.now(datetime.timezone.utc)).total_seconds()\\n        if left <= 0:\\n            print(\\\"⏱ time is up (deadline \\\" + local + \\\" Kampala)\\\" + (\\\"\\\" if practice else \\\": your work is collected\\\"))\\n            return\\n        m = int(left // 60)\\n        text = \\\"⏱ %d:%02d left (deadline %s Kampala)\\\" % (m // 60, m % 60, local)\\n        if m < 30:\\n            text += \\\"  Press Ctrl+S\\\" + (\\\" now: 10 minutes or less\\\" if m < 10 else \\\"\\\")\\n        print(text)\\n    old = globals().get(\\\"_iuea_countdown\\\")\\n    if old is not None:\\n        try:\\n            shell.events.unregister(\\\"post_run_cell\\\", old)\\n        except Exception:\\n            pass\\n    shell.events.register(\\\"post_run_cell\\\", line)\\n    globals()[\\\"_iuea_countdown\\\"] = line\\n_iuea_countdown_start()\\n\", \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 1: Clean the two tables (6 marks)\\n\", \"`houses`: from `houses_raw` keep only the columns `H_KEEP` (every column except the identifier PID), drop the houses with `Gr Liv Area` above 4000 sq ft (the data's author advises this: 5 unusual sales), and add `living_m2` = `Gr Liv Area` times 0.092903. Keep the missing values: the imputer fills them later from the training rows only.\\n\", \"`machines`: from `machines_raw` keep only `M_KEEP`, which drops the identifiers (`UDI`, `Product ID`) and `TWF`, `HDF`, `PWF`, `OSF`, `RNF` (they record the failure itself and would leak the answer), and turn `Type` into a number: L is 0, M is 1, H is 2. Do not change the raw tables.\\n\", \"Chart 1: a scatter of `Gr Liv Area` (across) against `H_TARGET` (up) from `houses`, with a title, both axis names and the unit (USD).\\n\", \"Data: houses from the Ames, Iowa assessor, 2006 to 2010 (De Cock 2011, Journal of Statistics Education 19(3)); machines from AI4I 2020 (Matzka 2020, UCI, CC BY 4.0), which is SYNTHETIC data modelled on real maintenance data.\\n\", \"\\n\", \"**Input:** `houses_raw`, `machines_raw`. **Store:** `houses`, `machines`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: houses, machines\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 2: Split into training and validation rows (2 marks)\\n\", \"Use exactly this rule for each table: `houses_valid = houses.sample(frac=0.25, random_state=17)` and `houses_train = houses.drop(houses_valid.index)`; the same for `machines`. The test rows (a fifth of each file) were set aside in the setup cell: we never tune on them, so they stay an honest test.\\n\", \"\\n\", \"**Input:** `houses`, `machines`. **Store:** `houses_train`, `houses_valid`, `machines_train`, `machines_valid`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: houses_train, houses_valid, machines_train, machines_valid\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 3: Question 1: predict the sale price of a house (13 marks)\\n\", \"Fit each model on `houses_train` only (columns `H_FEATURES`, target `H_TARGET`) and predict `houses_valid`: `make_pipeline(SimpleImputer(strategy=\\\"median\\\"), model)` with `DummyRegressor()`, `LinearRegression()` and `DecisionTreeRegressor(max_depth=4, random_state=17)`.\\n\", \"Then the MAE and RMSE of each on `houses_valid`, in USD.\\n\", \"Chart 2: a bar chart of the three MAE values, with a title, both axis names and the unit (USD).\\n\", \"\\n\", \"**Input:** `houses_train`, `houses_valid`. **Store:** `baseline_pred`, `linear_pred`, `tree_pred`, `baseline_mae`, `linear_mae`, `tree_mae`, `baseline_rmse`, `linear_rmse`, `tree_rmse`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: baseline_pred, linear_pred, tree_pred, baseline_mae, linear_mae, tree_mae, baseline_rmse, linear_rmse, tree_rmse\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 3b: Do the text columns help? (2 marks)\\n\", \"A comparison only (it is not one of the models in Task 5). Copy and adapt this recipe: it fills and one-hot encodes the text columns `TEXT_FEATURES`, learning only from `houses_train`:\\n\", \"`make_pipeline(make_column_transformer((SimpleImputer(strategy=\\\"median\\\"), H_FEATURES), (make_pipeline(SimpleImputer(strategy=\\\"most_frequent\\\"), OneHotEncoder(handle_unknown=\\\"ignore\\\")), TEXT_FEATURES)), LinearRegression())`\\n\", \"Fit it on `houses_train` (columns `H_FEATURES + TEXT_FEATURES`), predict `houses_valid`, and store the predictions and their MAE in USD.\\n\", \"\\n\", \"**Input:** `houses_train`, `houses_valid`. **Store:** `encoded_pred`, `encoded_mae`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: encoded_pred, encoded_mae\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 4: Question 2: warn of a machine failure (3 marks)\\n\", \"A warning is a machine failure (`Machine failure` is 1): `M_TARGET >= M_LIMIT`. Fit `make_pipeline(SimpleImputer(strategy=\\\"median\\\"), StandardScaler(), LogisticRegression(max_iter=1000))` on `machines_train` (columns `M_FEATURES`) and store the probability of a warning for each `machines_valid` row.\\n\", \"Warn when the probability is at least `THRESHOLD` (0.5), compare with the real warnings in `machines_valid`, and store the counts, precision and recall (0 when a count is zero).\\n\", \"\\n\", \"**Input:** `machines_train`, `machines_valid`. **Store:** `warning_proba`, `tp`, `fp`, `fn`, `tn`, `precision`, `recall`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: warning_proba, tp, fp, fn, tn, precision, recall\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 5: Choose one model\\n\", \"Use the supplied rule (MAE at most `MAX_MAE`, 25,000 USD, a teaching number; time at most `MAX_MS`; then the smallest MAE): `chosen_model = choose_model({\\\"baseline\\\": baseline_mae, \\\"linear\\\": linear_mae, \\\"tree\\\": tree_mae})`. Never use the test rows to choose.\\n\", \"\\n\", \"**Input:** `baseline_mae`, `linear_mae`, `tree_mae`. **Store:** `chosen_model`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: chosen_model\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 6: Open the test rows once (2 marks)\\n\", \"After Task 5, run `house_test, machine_test = open_test_set(chosen_model)` ONCE. Refit the chosen model on `houses_train` and `houses_valid` together and the warning model on `machines_train` and `machines_valid` together, then store the MAE on `house_test` and the recall of the warnings on `machine_test` at 0.5.\\n\", \"\\n\", \"**Input:** `houses_train`, `houses_valid`, `machines_train`, `machines_valid`, `chosen_model`. **Store:** `house_test`, `machine_test`, `test_mae`, `test_recall`.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Your code here. Store: house_test, machine_test, test_mae, test_recall\\n\"], \"execution_count\": null, \"outputs\": []}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## Task 7: Part B, the decision memo form (15 automatic marks)\\n\", \"Fill in `MEMO` in the next cell, for a property valuer (and, for the warning, the maintenance manager). Use your own numbers, at least two decimals, in USD. You may add one sentence on Task 3b to `answer_choice` (no extra mark).\\n\", \"\\n\", \"| Field | Enter | Marks |\\n\", \"|---|---|---|\\n\", \"| `recommended_model` | `\\\"baseline\\\"`, `\\\"linear\\\"` or `\\\"tree\\\"`: the model the rule chose and you opened the test set with. | 3 |\\n\", \"| `validation_mae` | The validation MAE of each model, from your notebook. | 3 |\\n\", \"| `test_mae`, `test_recall` | The MAE and the warning recall (0 to 1) from your one test opening. | 2 |\\n\", \"| `improvement_over_baseline` | Baseline validation MAE minus your model's (0 if you recommend the baseline). | 1 |\\n\", \"| `limits` | Three different letters: the true limits of this study. One mark each. | 3 |\\n\", \"| `next_step` | One letter: the best next step. | 1 |\\n\", \"| `answer_choice`, `answer_test_set` | Two answers in your own words, 8 to 80 words each. One mark each. | 2 |\\n\", \"\\n\", \"**Limits** (some statements are false):\\n\", \"- **A.** Fitting the imputer on the training rows only makes the validation results unreliable.\\n\", \"- **B.** Because the test rows were opened only once, the test results have no uncertainty at all.\\n\", \"- **C.** The test rows are one random fifth of each file, so the test results are one estimate that could be luckier or unluckier than the truth.\\n\", \"- **D.** The client limits (the error limit and the time limit) are invented teaching numbers; a real valuer would set their own.\\n\", \"- **E.** The test MAE proves that the model will be this accurate for every house in every town.\\n\", \"- **F.** The machine data are synthetic (generated to look like real maintenance data), so the warning results may not hold on a real machine.\\n\", \"- **G.** The model with the lowest training error is always the best model for new houses.\\n\", \"- **H.** The baseline model should be left out of the comparison because it uses no features.\\n\", \"- **I.** All the house sales come from one city (Ames, Iowa) between 2006 and 2010, so the model may not hold for other towns or later years.\\n\", \"- **J.** RMSE is always smaller than MAE, so MAE is the more severe measure and should be the only one reported.\\n\", \"\\n\", \"**Next step:**\\n\", \"- **A.** Move the test rows into the training rows so the model learns from more houses, and report the training error.\\n\", \"- **B.** Remove the baseline model from the report so the results look better.\\n\", \"- **C.** Collect sales from more towns and years, and real machine records, then check the chosen models again on rows they have never seen before any decision.\\n\", \"- **D.** Use the chosen model for every valuation now, because the test MAE is below the client limit.\\n\", \"- **E.** Tune the maximum depth of the decision tree until its test MAE is lowest, then report that test MAE.\\n\", \"\\n\", \"**Written answers:**\\n\", \"- `answer_choice`: In one or two sentences: why do you recommend this model? Use a number from the validation set and say what you compared it with.\\n\", \"- `answer_test_set`: In one or two sentences: why is the test set opened only once, at the very end, and never used to choose the model?\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"source\": [\"# Fill in every field; do not rename a field.\\n\", \"MEMO = {\\n\", \"    \\\"recommended_model\\\": \\\"\\\",                  # \\\"baseline\\\", \\\"linear\\\" or \\\"tree\\\"\\n\", \"    \\\"validation_mae\\\": {\\\"baseline\\\": None, \\\"linear\\\": None, \\\"tree\\\": None},   # your validation MAE values, in USD\\n\", \"    \\\"test_mae\\\": None,                         # the test MAE from your ONE opening, in USD\\n\", \"    \\\"test_recall\\\": None,                      # the test recall from your ONE opening (0 to 1)\\n\", \"    \\\"improvement_over_baseline\\\": None,        # baseline validation MAE minus your recommended model's, in USD\\n\", \"    \\\"limits\\\": [\\\"\\\", \\\"\\\", \\\"\\\"],                   # three different letters from the Limits list\\n\", \"    \\\"next_step\\\": \\\"\\\",                          # one letter from the Next step list\\n\", \"    \\\"answer_choice\\\": \\\"\\\",                      # one or two sentences\\n\", \"    \\\"answer_test_set\\\": \\\"\\\",                    # one or two sentences\\n\", \"}\\n\"], \"execution_count\": null, \"outputs\": []}], \"metadata\": {\"iuea_exam_version\": \"2026.11-ml-project-houses-machines-v7\", \"kernelspec\": {\"display_name\": \"Python 3\", \"language\": \"python\", \"name\": \"python3\"}}, \"nbformat\": 4, \"nbformat_minor\": 4}";
